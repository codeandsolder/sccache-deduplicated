{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "forkProcessing": "enabled",
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 3am"
    ],
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "bincode 2+ requires an explicit wire-format/protocol migration; bincode 3.0.0 is a compile-error placeholder",
      "matchManagers": [
        "cargo"
      ],
      "matchDepNames": [
        "bincode"
      ],
      "allowedVersions": "<2.0.0"
    },
    {
      "description": "The Rust 1.91 workflow entries are an intentional MSRV floor, not update targets",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "rust"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml"
      ],
      "enabled": false
    },
    {
      "description": "Cargo lockfile maintenance is age-gated by repository CI",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": null,
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
