{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "forkProcessing": "enabled",
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "separateMultipleMajor": false,
  "prConcurrentLimit": 6,
  "prHourlyLimit": 3,
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 3am"
    ],
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "The Rust 1.91 workflow entries are an intentional MSRV floor, not update targets",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "rust"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml"
      ],
      "enabled": false
    },
    {
      "description": "Group routine compatible stable Rust dependency updates",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchCurrentVersion": "!/^0/",
      "groupName": "routine stable Rust dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Pre-1.0 Rust dependency updates are reviewed individually",
      "matchManagers": [
        "cargo"
      ],
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    },
    {
      "description": "Latest major Rust dependency updates are attempted individually",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Cargo lockfile maintenance is age-gated by repository CI",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": null,
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group all GitHub Actions maintenance into one reviewed PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions tooling",
      "groupSlug": "github-actions-tooling",
      "automerge": false
    }
  ]
}
