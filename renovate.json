{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "forkProcessing": "enabled",
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 3am"
    ],
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "bincode 2+ requires an explicit wire-format/protocol migration; bincode 3.0.0 is a compile-error placeholder",
      "matchManagers": [
        "cargo"
      ],
      "matchDepNames": [
        "bincode"
      ],
      "allowedVersions": "<2.0.0"
    },
    {
      "description": "The Rust 1.91 workflow entries are an intentional MSRV floor, not update targets",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "rust"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml"
      ],
      "enabled": false
    },
    {
      "description": "The Ubuntu 24.04 publication runner is the intentional GLIBC 2.39 ABI floor",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "ubuntu"
      ],
      "matchFileNames": [
        ".github/workflows/publish-ci-client.yml"
      ],
      "enabled": false
    },
    {
      "description": "Wreq, BTLS and lurkmoar must agree on one Cargo git source identity for the native TLS provider",
      "matchManagers": [
        "cargo"
      ],
      "matchDepNames": [
        "wreq",
        "btls",
        "tokio-btls",
        "jsonwebtoken-btls",
        "lurkmoar"
      ],
      "groupName": "native transport stack",
      "groupSlug": "native-transport-stack",
      "automerge": false
    }
  ]
}
