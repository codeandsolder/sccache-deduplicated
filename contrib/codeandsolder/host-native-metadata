#!/usr/bin/env bash
set -euo pipefail

# Fingerprint stable machine/CPU identity, not clocks, load or CPU availability.
fingerprint() {
    [[ -s /etc/machine-id && -r /proc/cpuinfo ]]
    {
        sha256sum /etc/machine-id | cut -d ' ' -f1
        uname -m
        LC_ALL=C awk -F: '
            $1 ~ /^(vendor_id|cpu family|model|model name|stepping|flags|Features|CPU implementer|CPU architecture|CPU variant|CPU part|CPU revision)[[:space:]]*$/ {
                sub(/[[:space:]]+$/, "", $1)
                sub(/^[[:space:]]+/, "", $2)
                print $1 ":" $2
            }' /proc/cpuinfo | LC_ALL=C sort -u
    } | sha256sum | cut -d ' ' -f1
}

manifest_value() {
    local manifest="$1" key="$2" value
    value="$(sed -n "s/^$key=//p" "$manifest")"
    [[ -n "$value" && "$value" != *$'\n'* ]] || {
        echo "host-native-metadata: invalid or missing $key in $manifest" >&2
        return 1
    }
    printf '%s\n' "$value"
}

# Every component must be trusted for a root service to execute local binaries.
trusted_path() {
    local path="$1" mode owner
    [[ "$path" == /* && "$path" == "$(realpath -e -- "$path")" ]] || return 1
    while :; do
        [[ ! -L "$path" ]] || return 1
        read -r owner mode < <(stat -c '%u %a' -- "$path")
        [[ "$owner" == 0 && "$mode" =~ ^[0-7]+$ ]] || return 1
        (( (8#$mode & 022) == 0 )) || return 1
        [[ "$path" != / ]] || return 0
        path="$(dirname -- "$path")"
    done
}

# A scheduler generation has the same base release features plus the UI.
# All assets must be readable by the unprivileged scheduler account.
dashboard_manifest() (
    local directory="$1" file mode
    cd "$directory"
    for file in sccache-dashboard.js sccache-dashboard_bg.wasm sccache-dashboard.css; do
        [[ -s "pkg/$file" && -f "pkg/$file" ]] || exit 1
    done
    [[ -z "$(find pkg ! -type f ! -type d -print -quit)" ]] || exit 1
    while IFS= read -r -d '' file; do
        trusted_path "$directory/$file" || exit 1
        mode="$(stat -c '%a' "$file")"
        if [[ -d "$file" ]]; then
            (( (8#$mode & 005) == 005 )) || exit 1
        else
            (( (8#$mode & 004) == 004 )) || exit 1
        fi
    done < <(find pkg -print0)
    find pkg -type f -print0 | LC_ALL=C sort -z | xargs -0 -r sha256sum
)

# Check the complete set of paths before reading a checksum manifest; never
# permit a manifest to name an external file or traverse a symlink.
bundle_manifest() (
    local directory="$1" dashboard="$2"
    cd "$directory"
    sha256sum sccache sccache-dist build.txt
    if (( dashboard )); then
        dashboard_manifest "$directory"
    else
        [[ ! -e pkg && ! -L pkg ]] || exit 1
    fi
)

dashboard_check() {
    local directory="$1" link="$2" manifest="$3" expected
    [[ -L "$link" && "$(readlink "$link")" == "$directory/pkg" ]] || return 1
    trusted_path "$directory/SHA256SUMS" || return 1
    # Read only the generated asset rows, not filenames from an untrusted
    # manifest. Recompute the canonical list from trusted regular files.
    expected="$(dashboard_manifest "$directory")" || return 1
    [[ "$expected" == "$(sed -n '/^[0-9a-f]\{64\}  pkg\//p' "$manifest")" ]]
}

verify() {
    local directory="$1" published="$2" dashboard="${3:-0}" field native official file expected
    for file in sccache sccache-dist build.txt SHA256SUMS; do
        if ! [[ -f "$directory/$file" ]] || ! trusted_path "$directory/$file"; then
            echo "host-native-metadata: untrusted bundle file $directory/$file" >&2
            return 1
        fi
    done
    expected="$(bundle_manifest "$directory" "$dashboard")" || return 1
    [[ "$expected" == "$(cat "$directory/SHA256SUMS")" ]] || {
        echo "host-native-metadata: payload checksum manifest differs" >&2
        return 1
    }
    [[ "$(manifest_value "$directory/build.txt" build_kind)" == host-native ]]
    [[ "$(manifest_value "$directory/build.txt" rustflags)" == '-C target-cpu=native' ]]
    [[ "$(manifest_value "$directory/build.txt" host_fingerprint)" == "$(fingerprint)" ]] || {
        echo "host-native-metadata: bundle was built for a different machine/CPU" >&2
        return 1
    }
    for field in source_sha rust_toolchain features dist_protocol rollout_epoch tls_backend capabilities; do
        native="$(manifest_value "$directory/build.txt" "$field")"
        official="$(manifest_value "$published" "$field")"
        if [[ "$field" == features && "$dashboard" == 1 ]]; then official+=,scheduler-dashboard; fi
        [[ "$native" == "$official" ]] || {
            echo "host-native-metadata: $field differs from the published source release" >&2
            return 1
        }
    done
    [[ -x "$directory/sccache" && -x "$directory/sccache-dist" ]]
}

# Atomic generation selection. Call only after verified bundle admission and
# while the scheduler is stopped. The caller snapshots/restores the link.
dashboard_select() {
    local directory="$1" link="$2" parent temporary
    trusted_path "$directory/pkg" || return 1
    parent="$(dirname -- "$link")"
    install -d -m 0755 "$parent"
    trusted_path "$parent" || return 1
    [[ ! -e "$link" || -L "$link" ]] || return 1
    temporary="$(mktemp -d "$parent/.selection.XXXXXX")"
    ln -s "$directory/pkg" "$temporary/current"
    mv -Tf "$temporary/current" "$link"
    rmdir "$temporary"
}

case "${1:-}" in
    fingerprint) [[ $# == 1 ]]; fingerprint ;;
    verify)
        [[ $# == 3 || ( $# == 4 && $4 == --scheduler-dashboard ) ]]
        dashboard=0
        if [[ ${4:-} == --scheduler-dashboard ]]; then dashboard=1; fi
        verify "$2" "$3" "$dashboard"
        ;;
    dashboard-select) [[ $# == 3 ]]; dashboard_select "$2" "$3" ;;
    dashboard-check) [[ $# == 4 ]]; dashboard_check "$2" "$3" "$4" ;;
    *) echo "usage: $0 fingerprint | verify ABSOLUTE_BUNDLE_DIRECTORY PUBLISHED_BUILD_TXT [--scheduler-dashboard] | dashboard-select BUNDLE_DIRECTORY ASSET_LINK | dashboard-check BUNDLE_DIRECTORY ASSET_LINK MANIFEST" >&2; exit 2 ;;
esac

