#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(mktemp -d)"
trap 'rm -rf -- "$root"' EXIT
scratch="$root/client/toolchain_tmp"
preflight() {
    SCCACHE_DIST_CLIENT_CACHE_DIR="$root" "$here/sccache-dist-client-preflight"
}
must_reject() {
    local status=0
    preflight || status=$?
    [[ "$status" == 1 ]]
}

# A not-yet-created cache and an absent scratch directory are both harmless.
preflight
mkdir -p "$scratch" "$root/client/tc" "$root/elsewhere"
printf '%s' stale > "$scratch/stale"
printf '%s' '{"keep":"yes"}' > "$root/client/weak_map.json"
printf '%s' cached > "$root/client/tc/keep"
printf '%s' preserve > "$root/elsewhere/keep"
preflight
[[ ! -e "$scratch" && ! -L "$scratch" ]]
[[ "$(cat "$root/client/weak_map.json")" == '{"keep":"yes"}' ]]
[[ "$(cat "$root/client/tc/keep")" == cached ]]
preflight

# Reject unexpected object types, even when a symlink target is absent.
printf '%s' file > "$scratch"
must_reject
[[ "$(cat "$scratch")" == file ]]
rm -- "$scratch"
ln -s "$root/elsewhere" "$scratch"
must_reject
[[ -L "$scratch" && "$(cat "$root/elsewhere/keep")" == preserve ]]
rm -- "$scratch"
ln -s "$root/nonexistent" "$scratch"
must_reject
[[ -L "$scratch" && ! -e "$scratch" ]]
printf 'distributed client preflight tests passed\n'
