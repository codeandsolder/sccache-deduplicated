# Bump both fields for incompatible scheduler/worker heartbeat changes.
# A new rollout epoch stops existing host updaters until a coordinated cutover.
dist_protocol=2
rollout_epoch=3
# Keep binaries compatible with the least-new fleet baseline.
glibc_abi_max=2.39
# Published distributed workers must embed OpenSSL statically.
# Enforced by the native ABI verifier; no libssl/libcrypto DT_NEEDED.
