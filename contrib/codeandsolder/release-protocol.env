# Bump both fields for incompatible distributed client, worker or scheduler wire changes.
# A new rollout epoch stops existing host updaters until a coordinated cutover.
dist_protocol=7
rollout_epoch=8
rust_toolchain=nightly-2026-11-20
# Keep binaries compatible with the least-new fleet baseline.
glibc_abi_max=2.39
# Published distributed workers embed BoringSSL and its C++ runtime statically.
# Enforced by the native ABI verifier; no TLS or C++ runtime DSO dependencies.
