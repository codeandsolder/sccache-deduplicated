#!/usr/bin/env bash
set -euo pipefail

root=$(mktemp -d)
trap 'rm -rf -- "$root"' EXIT
mkdir -p "$root/bin" "$root/state"
old_sha=1111111111111111111111111111111111111111
new_sha=2222222222222222222222222222222222222222
tag=sccache-ci-$new_sha
release="$root/cache/$tag"
mkdir -p "$release"
cat > "$root/bin/curl" <<'MOCK'
#!/usr/bin/env bash
case "${*: -1}" in
    */releases/tags/*) printf '{"published_at":"2026-01-01T00:00:00Z"}\n';;
    */compare/*) printf '{"status":"ahead"}\n';;
    *) echo "Unexpected request: $*" >&2; exit 1;;
esac
MOCK
cat > "$root/bin/systemctl" <<'MOCK'
#!/usr/bin/env bash
if [[ "$1" == is-active ]]; then
    exit 0
fi
echo "Unexpected service mutation: $*" >&2
exit 1
MOCK
cat > "$root/bin/ss" <<'MOCK'
#!/usr/bin/env bash
echo 'Queue occupancy must not be queried' >&2
exit 1
MOCK
cat > "$release/sccache-linux-x86_64-v2" <<'MOCK'
#!/usr/bin/env bash
case "$1" in
    --capabilities) echo direct-metrics;;
    --version) echo sccache-test;;
    *) exit 1;;
esac
MOCK
cp "$release/sccache-linux-x86_64-v2" "$release/sccache-dist-linux-x86_64-v2"
cp "$release/sccache-linux-x86_64-v2" "$root/live"
cp "$release/sccache-dist-linux-x86_64-v2" "$root/dist"
printf '\n# old client\n' >> "$root/live"
printf '\n# old worker\n' >> "$root/dist"
chmod +x "$root/bin/"* "$root/live" "$root/dist"
printf '%s\n' "$old_sha" > "$root/state/client_source_sha"
sha256sum "$root/dist" | cut -d' ' -f1 > "$root/state/dist_sha256"
printf '3\n' > "$root/state/dist_protocol"
cat > "$release/build.txt" <<EOF
source_sha=$new_sha
rust_toolchain=nightly-2026-11-20
rustflags=-C target-cpu=x86-64-v2
features=s3,dist-client,dist-server,direct-metrics
dist_protocol=3
rollout_epoch=4
capabilities=direct-metrics
EOF
checksum() {
    (cd "$release"; sha256sum sccache-linux-x86_64-v2 sccache-dist-linux-x86_64-v2 build.txt > SHA256SUMS)
}
checksum

export PATH="$root/bin:$PATH"
export SCCACHE_AUTOUPDATE_STATE_DIR="$root/state"
export SCCACHE_AUTOUPDATE_CACHE_DIR="$root/cache"
export SCCACHE_AUTOUPDATE_TAG="$tag"
export SCCACHE_AUTOUPDATE_LIVE="$root/live"
export SCCACHE_AUTOUPDATE_DIST_LIVE="$root/dist"
export SCCACHE_AUTOUPDATE_LOCK="$root/lock"
export SCCACHE_AUTOUPDATE_EXPECTED_ROLLOUT_EPOCH=4
export SCCACHE_AUTOUPDATE_EXPECTED_RUST_TOOLCHAIN=nightly-2026-11-20
export SCCACHE_AUTOUPDATE_VERIFY_DIST_SMOKE=1
export SCCACHE_AUTOUPDATE_NATIVE_BUNDLE_ROOT=""
updater=$(dirname -- "$0")/sccache-release-update
result=$("$updater" --plan-only)
[[ "$result" == *"plan client_update_required=1 dist_update_required=1 dist_was_active=1 current_dist_protocol=3 candidate_dist_protocol=3"* ]]
echo 'Same-protocol plan succeeds without consulting scheduler activity or local connections'

sed -i 's/^dist_protocol=3$/dist_protocol=4/' "$release/build.txt"
checksum
if result=$("$updater" --plan-only 2>&1); then
    echo "Incompatible protocol was accepted" >&2
    exit 1
fi
[[ "$result" == *"coordinated migration required"* ]]
echo 'Incompatible protocol requires coordinated migration'
