#!/usr/bin/env bash
# Install the reviewed runtime components without touching the compiler daemon.
set -euo pipefail
[[ $EUID == 0 && $# == 0 ]] || { echo 'Run install-profile-broker as root after configuring the fleet authority' >&2; exit 64; }
here=$(dirname -- "$(realpath -- "$0")")
read -r authority < /etc/sccache/runtime-profile-authority
case "$authority" in
    local) ;;
    ssh) [[ -r /etc/sccache/runtime-profile-ssh.conf ]] ;;
    *) echo 'Invalid profile authority' >&2; exit 65 ;;
esac
for cmd in docker socat zstd ssh systemctl; do command -v "$cmd" >/dev/null; done
getent group docker >/dev/null
read -r base < /etc/sccache/runtime-image
[[ $base =~ ^sha256:[0-9a-f]{64}$ ]]
[[ $(docker image inspect --format '{{.Id}}' "$base") == "$base" ]]
install_atomic() (
    local from=$1 to=$2 mode=$3 temp
    install -d -m 0755 "$(dirname -- "$to")"
    temp=$(mktemp "$(dirname -- "$to")/.runtime-profile.XXXXXX")
    trap 'rm -f -- "$temp"' EXIT
    install -o root -g root -m "$mode" "$from" "$temp"
    mv -Tf -- "$temp" "$to"
)
install_atomic "$here/Dockerfile.profile" /usr/local/share/sccache-runtime/Dockerfile.profile 0644
install_atomic "$here/sccache-runtime-profile" /usr/local/bin/sccache-runtime-profile 0755
install_atomic "$here/sccache-runtime-profile-service" /usr/local/libexec/sccache-runtime-profile-service 0755
install_atomic "$here/sccache-runtime-profile.socket" /etc/systemd/system/sccache-runtime-profile.socket 0644
install_atomic "$here/sccache-runtime-profile@.service" /etc/systemd/system/sccache-runtime-profile@.service 0644
systemctl daemon-reload
systemctl enable --now sccache-runtime-profile.socket
systemctl is-active --quiet sccache-runtime-profile.socket
[[ -S /run/sccache-runtime-profile.sock ]]
install_atomic "$here/run" /usr/local/bin/sccache-runtime 0755
