#!/usr/bin/env bash
set -euo pipefail

REAL="${CODEANDSOLDER_REAL_CARGO:-/usr/local/libexec/cargo-codeandsolder-real}"
args=("$@")

if (( ${#args[@]} )) && [[ "${args[0]}" == +* ]]; then
    export RUSTUP_TOOLCHAIN="${args[0]#+}"
    args=("${args[@]:1}")
fi

export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"

# Keep nested Cargo invocations (build scripts and external subcommands) on
# this launcher rather than exposing the underlying real Cargo binary. The
# cargo-ephemeral fork consumes this variable in GlobalContext::cargo_exe().
export EPHEMERAL_CARGO_WRAPPER="${EPHEMERAL_CARGO_WRAPPER:-$(readlink -f "$0")}"
export CARGO="$EPHEMERAL_CARGO_WRAPPER"

# The real Cargo binary below is not the rustup proxy. Resolve the active
# toolchain once in the caller's working directory so rustc invocations run
# with the repository's rust-toolchain(.toml) override even when Cargo changes
# a child process cwd into the registry or another dependency directory.
if [[ -z "${RUSTUP_TOOLCHAIN+x}" ]]; then
    if active_toolchain="$(rustup show active-toolchain 2>/dev/null)"; then
        export RUSTUP_TOOLCHAIN="${active_toolchain%% *}"
    fi
fi

compile=0
for arg in "${args[@]}"; do
    case "$arg" in
        build|check|test|run|bench|rustc|rustdoc|doc|clippy|fix)
            compile=1
            break
            ;;
    esac
done

if (( compile )) && [[ -z "${CARGO_INCREMENTAL+x}" ]]; then
    export CARGO_INCREMENTAL=0
fi

# Resolve the effective target root without exporting CARGO_TARGET_DIR: doing
# that changes Cargo semantics and masks project-local [build] target-dir.
# A nested Cargo invocation inherits the parent wrapper's derived root, so mark
# derived values and recompute them at each Cargo boundary. An unmarked value is
# an explicit caller override and is preserved.
if [[ "${SCCACHE_CANONICAL_TARGET_ROOT_ORIGIN:-}" == "codeandsolder-cargo-wrapper" ]]; then
    unset SCCACHE_CANONICAL_TARGET_ROOT SCCACHE_CANONICAL_TARGET_ROOT_ORIGIN
fi
if (( compile )) && [[ -z "${SCCACHE_CANONICAL_TARGET_ROOT:-}" ]]; then
    target_dir_arg=""
    metadata_args=(metadata --no-deps --format-version 1)

    for ((i=0; i<${#args[@]}; i++)); do
        case "${args[i]}" in
            -m|--manifest-path)
                if (( i+1 < ${#args[@]} )); then
                    metadata_args+=(--manifest-path "${args[i+1]}")
                    ((i+=1))
                fi
                ;;
            -m=*|--manifest-path=*)
                metadata_args+=(--manifest-path "${args[i]#*=}")
                ;;
            --config)
                if (( i+1 < ${#args[@]} )); then
                    metadata_args+=(--config "${args[i+1]}")
                    ((i+=1))
                fi
                ;;
            --config=*)
                metadata_args+=("${args[i]}")
                ;;
            --target-dir)
                if (( i+1 < ${#args[@]} )); then
                    target_dir_arg="${args[i+1]}"
                    ((i+=1))
                fi
                ;;
            --target-dir=*)
                target_dir_arg="${args[i]#*=}"
                ;;
        esac
    done

    canonical_target=""
    if [[ -n "$target_dir_arg" ]]; then
        canonical_target="$(realpath -m -- "$target_dir_arg")"
    elif [[ -n "${CARGO_TARGET_DIR+x}" ]]; then
        canonical_target="$(realpath -m -- "$CARGO_TARGET_DIR")"
    else
        metadata_json="$("$REAL" "${metadata_args[@]}" 2>/dev/null || true)"
        if [[ -n "$metadata_json" ]]; then
            canonical_target="$(jq -r '.target_directory // empty' <<<"$metadata_json")"
        fi
    fi

    if [[ -n "$canonical_target" ]]; then
        export SCCACHE_CANONICAL_TARGET_ROOT="$canonical_target"
        export SCCACHE_CANONICAL_TARGET_ROOT_ORIGIN=codeandsolder-cargo-wrapper
    fi
fi

# Enable native provider only after the managed rollout marker is installed.
native_marker="${CODEANDSOLDER_NATIVE_PREBUILT_MARKER:-/etc/sccache/native-prebuilt-enabled}"
if (( compile )) && [[ -f "$native_marker" ]]; then
    native_root="${CODEANDSOLDER_NATIVE_PREBUILT_ROOT:-/usr/local/libexec/native-boringssl}"
    native_env="${CODEANDSOLDER_NATIVE_PREBUILT_GARAGE_ENV:-/etc/sccache/native-prebuilt-garage.env}"
    for name in boringssl-build-provider boringssl-prebuilt native-garage-store; do
        [[ -x "$native_root/$name" ]] || {
            echo "cargo-wrapper: native provider component missing: $native_root/$name" >&2
            exit 1
        }
    done
    [[ -r "$native_env" ]] || {
        echo "cargo-wrapper: native Garage config unreadable: $native_env" >&2
        exit 1
    }
    export CARGO_NATIVE_PREBUILT_PROVIDER="$native_root/boringssl-build-provider"
    export CARGO_NATIVE_PREBUILT_PACKAGES=boring-sys,btls-sys
    native_revision="$(
        sha256sum "$native_root/boringssl-build-provider" \
                  "$native_root/boringssl-prebuilt" \
                  "$native_root/native-garage-store" | sha256sum | cut -d ' ' -f1
    )"
    export CARGO_NATIVE_PREBUILT_PROVIDER_REVISION="$native_revision"
    export BORING_BSSL_STORE_BACKEND=garage
    export BORING_BSSL_GARAGE_ENV="$native_env"
    export SENTINELX_CARGO_WRAPPER_PATH="$EPHEMERAL_CARGO_WRAPPER"
fi

exec "$REAL" "${args[@]}"
