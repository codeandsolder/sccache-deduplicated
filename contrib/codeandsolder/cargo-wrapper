#!/usr/bin/env bash
set -euo pipefail

# The native frontend owns dependency resolution and build-wide leases.
# No upstream package manager process is launched.
cargo_wrapper_main() {
    local binary="$1"
    shift
    exec "$binary" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    cargo_wrapper_main /usr/local/bin/sccache "$@"
fi
