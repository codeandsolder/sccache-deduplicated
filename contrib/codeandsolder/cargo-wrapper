#!/usr/bin/env bash
set -euo pipefail

# The binary owns Cargo scratch leases and invokes the selected upstream
# toolchain. Do not parse or rewrite Cargo's command line here.
cargo_wrapper_main() {
    local binary="$1"
    shift
    exec "$binary" --cargo-final -- "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    cargo_wrapper_main /usr/local/libexec/sccache-bin/sccache "$@"
fi
