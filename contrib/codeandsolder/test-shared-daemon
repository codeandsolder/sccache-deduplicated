#!/usr/bin/env bash
# Run only on a disposable Linux CI runner, through sudo. The managed fleet
# must not be touched. The optional JSON file supplies native distribution.
set -euo pipefail
umask 022

binary=${1:?sccache test binary required}
dist=${2:-}
wrapper_digest=${3:?recursive wrapper digest required}
[[ "$wrapper_digest" =~ ^[0-9a-f]{64}$ ]]
uid=${SUDO_UID:?run this regression with sudo from a non-root account}
gid=${SUDO_GID:?run this regression with sudo from a non-root account}
[[ $EUID == 0 && $uid != 0 ]]
root=$(mktemp -d /run/sccache-shared-test.XXXXXX)
report_parser=$(dirname -- "${BASH_SOURCE[0]}")/native-action-report.awk
server_pid=
cleanup() {
    local status=$?
    if [[ -n $server_pid ]]; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    if (( status != 0 )); then
        cat "$root/server.log" >&2 || true
        cat "$root"/root-private/*.log >&2 || true
    fi
    rm -rf -- "$root"
}
trap cleanup EXIT
chmod 755 "$root"
install -o root -g root -m 755 "$binary" "$root/sccache"
install -d -m 700 "$root/root-private" "$root/cache"
# This recursive launcher is intentionally identical to a strict host
# compiler wrapper: if the executor runs it, it will submit to itself.
cat > "$root/strict-cc" <<'WRAPPER'
#!/bin/sh
exec "$(dirname -- "$0")/sccache" /usr/bin/gcc "$@"
WRAPPER
chmod 0755 "$root/strict-cc"
ln -s strict-cc "$root/cc"
ln -s cc "$root/host-cc"
install -d -o "$uid" -g "$gid" -m 700 "$root/user-private"
touch "$root/client.toml"
chmod 644 "$root/client.toml"
# Configuration and scheduler credentials are visible only to root.
if [[ -z $dist ]]; then
    printf '{}\n' > "$root/distribution.json"
else
    cp "$dist" "$root/distribution.json"
fi
jq -n --arg dir "$root/cache" --argjson uid "$uid" --argjson gid "$gid" \
    --arg alias "$root/strict-cc" --arg digest "$wrapper_digest" \
    --slurpfile dist "$root/distribution.json" \
    '{cache: {disk: {dir: $dir, size: 104857600}}, shared_daemon: {socket_gid: $gid, allowed_uids: [$uid]}, compiler_aliases: {($alias): {compiler: "/usr/bin/gcc", blake3: $digest}}, dist: ($dist[0] + {cache_dir: ($dir + "/toolchains")})}' \
    > "$root/server.json"
chmod 600 "$root/server.json" "$root/distribution.json"
env -i PATH=/usr/bin:/bin HOME="$root/root-private" SCCACHE_CONF="$root/server.json" \
    SCCACHE_SERVER_UDS="$root/service.sock" SCCACHE_START_SERVER=1 SCCACHE_NO_DAEMON=1 \
    SCCACHE_IDLE_TIMEOUT=0 SCCACHE_LOG=info,sccache::server::shared::digests=debug "$root/sccache" >"$root/server.log" 2>&1 &
server_pid=$!

client() {
    env -i PATH=/usr/bin:/bin HOME="$root/user-private" SCCACHE_CONF="$root/client.toml" \
        SCCACHE_SERVER_UDS="$root/service.sock" SCCACHE_NO_AUTO_START_SERVER=1 SCCACHE_LOG=sccache::native_action=info \
        "$root/sccache" "$@"
}
user_client() {
    local mode=()
    if [[ ${SCCACHE_RECACHE:-} == 1 ]]; then mode=(SCCACHE_RECACHE=1); fi
    setpriv --reuid "$uid" --regid "$gid" --groups "$gid" -- \
        env -i PATH=/usr/bin:/bin HOME="$root/user-private" SCCACHE_CONF="$root/client.toml" \
        SCCACHE_SERVER_UDS="$root/service.sock" SCCACHE_NO_AUTO_START_SERVER=1 SCCACHE_LOG=sccache::native_action=info "${mode[@]}" \
        "$root/sccache" "$@"
}
stats() {
    client --show-stats --stats-format=json
}
for ((i=0; i<200; i++)); do
    [[ -S $root/service.sock ]] && stats >/dev/null 2>&1 && break
    kill -0 "$server_pid"
    sleep .1
done
[[ $(stat -c '%u:%g:%a' "$root/service.sock") == "0:$gid:660" ]]
stats >/dev/null

# Same exact source, same pathname and command: share a cache entry across
# UIDs, but each materialization belongs to the requesting UID.
cd "$root/user-private"
printf 'int shared_value(void) { return 42; }\n' > probe.c
chown "$uid:$gid" probe.c
chmod 600 probe.c
user_client /usr/bin/gcc -c probe.c -o probe.o 2>"$root/root-private/first.log"
[[ $(stat -c '%u:%g' probe.o) == "$uid:$gid" ]]
reference=$(sha256sum probe.o | cut -d' ' -f1)
rm probe.o
before=$(stats | jq '.stats.cache_hits.counts | [.[]] | add // 0')
client /usr/bin/gcc -c probe.c -o probe.o 2>"$root/root-private/root-hit.log"
[[ $(stat -c '%u' probe.o) == 0 ]]
[[ $(sha256sum probe.o | cut -d' ' -f1) == "$reference" ]]
after=$(stats | jq '.stats.cache_hits.counts | [.[]] | add // 0')
(( after == before + 1 ))
if [[ -n $dist ]]; then
    read -r key source < <(awk -v mode=reuse -v exact_source=1 -f "$report_parser" "$root/root-private/first.log")
    [[ $source == worker ]]
    [[ $(awk -v mode=reuse -v exact_source=1 -f "$report_parser" "$root/root-private/root-hit.log") == "$key hit" ]]
    rm probe.o
    SCCACHE_RECACHE=1 user_client /usr/bin/gcc -c probe.c -o probe.o 2>"$root/root-private/refresh.log"
    [[ $(awk -v mode=refresh -v exact_source=1 -f "$report_parser" "$root/root-private/refresh.log") == "$key worker" ]]
    [[ $(sha256sum probe.o | cut -d' ' -f1) == "$reference" ]]
fi
rm probe.o
user_client /usr/bin/gcc -c probe.c -o probe.o
[[ $(stat -c '%u:%g' probe.o) == "$uid:$gid" ]]
[[ $(sha256sum probe.o | cut -d' ' -f1) == "$reference" ]]

# Exercise both direct and indirect aliases concurrently from a genuine
# credential-dropping shared executor. Same compiler, source and artifact
# identity must hit rather than recursively call the same daemon.
before=$(stats | jq '.stats.cache_hits.counts | [.[]] | add // 0')
rm probe.o
user_client "$root/host-cc" -c probe.c -o probe.o &
a=$!
client "$root/cc" -c probe.c -o alias.o &
b=$!
wait "$a"
wait "$b"
[[ $(stat -c '%u:%g' probe.o) == "$uid:$gid" ]]
[[ $(stat -c '%u' alias.o) == 0 ]]
[[ $(sha256sum probe.o | cut -d' ' -f1) == "$reference" ]]
[[ $(sha256sum alias.o | cut -d' ' -f1) == "$reference" ]]
after=$(stats | jq '.stats.cache_hits.counts | [.[]] | add // 0')
(( after == before + 2 ))
rm alias.o
# A changed launcher is not silently resolved by any spelling.
cp "$root/strict-cc" "$root/strict-cc.original"
printf '# altered\n' >> "$root/strict-cc"
if user_client "$root/host-cc" -c probe.c -o tampered.o; then
    echo "modified compiler alias accepted" >&2
    exit 1
fi
[[ ! -e tampered.o ]]
mv "$root/strict-cc.original" "$root/strict-cc"

# Different masks must produce distinct entries, including on the remote
# worker. A hit must preserve the exact restrictive output mode.
rm probe.o
before=$(stats | jq '.stats.cache_hits.counts | [.[]] | add // 0')
(umask 077; user_client /usr/bin/gcc -c probe.c -o probe.o)
[[ $(stat -c '%a' probe.o) == 600 ]]
[[ $(stat -c '%u:%g' probe.o) == "$uid:$gid" ]]
[[ $(sha256sum probe.o | cut -d' ' -f1) == "$reference" ]]
after=$(stats | jq '.stats.cache_hits.counts | [.[]] | add // 0')
(( after == before ))
rm probe.o
(umask 077; user_client /usr/bin/gcc -c probe.c -o probe.o)
[[ $(stat -c '%a' probe.o) == 600 ]]
after=$(stats | jq '.stats.cache_hits.counts | [.[]] | add // 0')
(( after == before + 1 ))

# A root-private source is available to root, not to the ordinary caller.
cd "$root/root-private"
printf 'int root_private_value(void) { return 7; }\n' > private.c
chmod 600 private.c
client /usr/bin/gcc -c private.c -o private.o
[[ $(stat -c '%u' private.o) == 0 ]]
cd "$root/user-private"
if user_client /usr/bin/gcc -c "$root/root-private/private.c" -o forbidden.o; then
    echo "unprivileged compile read root-private source" >&2
    exit 1
fi
[[ ! -e forbidden.o ]]

# The server-owned fallback must consume the real caller stdin; this cannot
# be implemented by launching the compiler in the public CLI.
printf 'int streamed_value(void) { return 13; }\n' | user_client /usr/bin/gcc -x c - -c -o streamed.o
[[ $(stat -c '%u:%g' streamed.o) == "$uid:$gid" ]]
nm streamed.o | rg -q 'streamed_value$'

# A wrapper observes the actual compiler process ancestry. The server helper
# is the compiler's ancestor, rather than the public client's process tree.
cat > compiler-wrapper <<'WRAPPER'
#!/bin/sh
printf '%s %s %s\n' "$(id -u)" "$PPID" "$(awk '/^PPid:/ { print $2 }' "/proc/$PPID/status")" >> ancestry
exec /usr/bin/gcc "$@"
WRAPPER
chmod 755 compiler-wrapper
chown "$uid:$gid" compiler-wrapper
user_client "$root/user-private/compiler-wrapper" -c probe.c -o wrapper.o
[[ -s ancestry ]]
awk -v uid="$uid" -v parent="$server_pid" '
    $1 != uid || $3 != parent { bad=1 }
    END { exit bad || NR == 0 }
' ancestry
[[ $(stat -c '%u' wrapper.o) == "$uid" ]]

# Overlap local root and ordinary-user compiler execution. Each actual
# invocation must rendezvous with the other before returning. Discovery
# probes and preprocessing do not participate.
if [[ -z $dist ]]; then
    cat > concurrent-wrapper <<'WRAPPER'
#!/bin/sh
case " $* " in
    *" -c "*parallel-a.o*) touch parallel-a.started ;;
    *" -c "*parallel-b.o*) touch parallel-b.started ;;
    *) exec /usr/bin/gcc "$@" ;;
esac
for i in $(seq 1 200); do
    if [ -e parallel-a.started ] && [ -e parallel-b.started ]; then
        exec /usr/bin/gcc "$@"
    fi
    sleep .05
done
exit 1
WRAPPER
    chmod 755 concurrent-wrapper
    chown "$uid:$gid" concurrent-wrapper
    printf 'int parallel_a(void) { return 1; }\n' > parallel-a.c
    printf 'int parallel_b(void) { return 2; }\n' > parallel-b.c
    chown "$uid:$gid" parallel-*.c
    client "$root/user-private/concurrent-wrapper" -c parallel-a.c -o parallel-a.o &
    a=$!
    user_client "$root/user-private/concurrent-wrapper" -c parallel-b.c -o parallel-b.o &
    b=$!
    wait "$a"
    wait "$b"
    [[ $(stat -c '%u' parallel-a.o) == 0 ]]
    [[ $(stat -c '%u' parallel-b.o) == "$uid" ]]

    # Cancel an accepted server-owned compile by disconnecting its caller.
    # The daemon must terminate the whole compiler group and remain usable.
    cat > cancel-wrapper <<'WRAPPER'
#!/bin/sh
case " $* " in
    *" -c "*cancel.o*)
        printf '%s\n' "$$" > cancel.started
        sleep 60
        ;;
esac
exec /usr/bin/gcc "$@"
WRAPPER
    chmod 755 cancel-wrapper
    chown "$uid:$gid" cancel-wrapper
    printf 'int cancelled(void) { return 3; }\n' > cancel.c
    chown "$uid:$gid" cancel.c
    setpriv --reuid "$uid" --regid "$gid" --groups "$gid" -- \
        env -i PATH=/usr/bin:/bin HOME="$root/user-private" SCCACHE_CONF="$root/client.toml" \
        SCCACHE_SERVER_UDS="$root/service.sock" SCCACHE_NO_AUTO_START_SERVER=1 \
        "$root/sccache" "$root/user-private/cancel-wrapper" -c cancel.c -o cancel.o &
    caller=$!
    for ((i=0; i<200; i++)); do
        [[ -s cancel.started ]] && break
        kill -0 "$caller"
        sleep .05
    done
    [[ -s cancel.started ]]
    compiler_pid=$(cat cancel.started)
    kill "$caller"
    wait "$caller" || true
    for ((i=0; i<200; i++)); do
        [[ ! -r /proc/$compiler_pid/stat ]] && break
        [[ $(awk '{print $3}' "/proc/$compiler_pid/stat" 2>/dev/null || true) == Z ]] && break
        sleep .05
    done
    if [[ -r /proc/$compiler_pid/stat ]]; then
        [[ $(awk '{print $3}' "/proc/$compiler_pid/stat" 2>/dev/null || true) == Z ]]
    fi
    [[ ! -e cancel.o ]]
    user_client /usr/bin/gcc -c cancel.c -o aftercancel.o
    [[ $(stat -c '%u' aftercancel.o) == "$uid" ]]
fi

# Socket group membership alone is insufficient. An ordinary authorized UID
# also cannot use administrative or raw namespace/client-side compile RPCs.
other=65534
[[ $uid != "$other" ]] || other=65533
if setpriv --reuid "$other" --regid "$gid" --groups "$gid" -- \
    env -i PATH=/usr/bin:/bin HOME=/tmp SCCACHE_CONF="$root/client.toml" \
    SCCACHE_SERVER_UDS="$root/service.sock" SCCACHE_NO_AUTO_START_SERVER=1 \
    "$root/sccache" --show-stats; then
    echo "unauthorized UID accessed shared daemon" >&2
    exit 1
fi
if user_client --zero-stats; then
    echo "ordinary UID reset shared statistics" >&2
    exit 1
fi
if setpriv --reuid "$uid" --regid "$gid" --groups "$gid" -- \
    env -i PATH=/usr/bin:/bin HOME="$root/user-private" SCCACHE_CONF="$root/client.toml" \
    SCCACHE_SERVER_UDS="$root/service.sock" SCCACHE_NO_AUTO_START_SERVER=1 SCCACHE_CLIENT_SIDE=1 \
    "$root/sccache" /usr/bin/gcc -c probe.c -o caller.o; then
    echo "shared endpoint allowed caller-owned compilation" >&2
    exit 1
fi
[[ ! -e caller.o ]]

# Exercise an alternate mount view of the same pathname, without moving the
# root daemon into the caller's filesystem namespace.
install -d -o "$uid" -g "$gid" -m 700 "$root/alternate" "$root/user-private/view"
printf 'int namespace_visible(void) { return 8; }\n' > "$root/alternate/visible.c"
chown "$uid:$gid" "$root/alternate/visible.c"
# shellcheck disable=SC2016 # Positional parameters belong to the inner shell.
unshare --mount --propagation private -- bash -eu -c '
    mount --bind "$1/alternate" "$1/user-private/view"
    cd "$1/user-private/view"
    exec setpriv --reuid "$2" --regid "$3" --groups "$3" -- \
        env -i PATH=/usr/bin:/bin HOME="$1/user-private" SCCACHE_CONF="$1/client.toml" \
        SCCACHE_SERVER_UDS="$1/service.sock" SCCACHE_NO_AUTO_START_SERVER=1 \
        "$1/sccache" /usr/bin/gcc -c visible.c -o visible.o
' _ "$root" "$uid" "$gid"
[[ ! -e "$root/user-private/view/visible.o" ]]
[[ $(stat -c '%u:%g' "$root/alternate/visible.o") == "$uid:$gid" ]]
nm "$root/alternate/visible.o" | rg -q 'namespace_visible$'

# A normal rootful container has a distinct PID namespace and procfs.
# Check the compiler's own namespace rather than only the output path.
install -d -o "$uid" -g "$gid" -m 700 "$root/user-private/pid-compiler"
cat > "$root/user-private/pid-compiler/gcc" <<'CHECK'
#!/bin/sh
set -eu
test "$(readlink /proc/self/ns/pid)" = "$(cat expected-pidns)"
exec /usr/bin/gcc "$@"
CHECK
chmod 755 "$root/user-private/pid-compiler/gcc"
# shellcheck disable=SC2016
unshare --mount --pid --fork --mount-proc --propagation private -- bash -eu -c '
    cd "$1/user-private"
    printf "%s\n" "$(readlink /proc/self/ns/pid)" > expected-pidns
    chown "$2:$3" expected-pidns
    exec setpriv --reuid "$2" --regid "$3" --groups "$3" -- \
        env -i PATH=/usr/bin:/bin HOME="$1/user-private" SCCACHE_CONF="$1/client.toml" \
        SCCACHE_SERVER_UDS="$1/service.sock" SCCACHE_NO_AUTO_START_SERVER=1 \
        "$1/sccache" "$1/user-private/pid-compiler/gcc" -c probe.c -o pid.o
' _ "$root" "$uid" "$gid"
[[ $(stat -c '%u:%g' "$root/user-private/pid.o") == "$uid:$gid" ]]
nm "$root/user-private/pid.o" | rg -q 'shared_value$'

if [[ -n $dist ]]; then
    stats | jq -e '[.stats.dist_compiles[]] | add > 0' >/dev/null
    rg -q 'shared toolchain memo: reused [1-9][0-9]* files' "$root/server.log"
fi
client --stop-server
wait "$server_pid"
server_pid=
echo "shared daemon credential, cache, fallback and mount namespace regression passed"
