  if [[ $(findmnt -n -o FSTYPE -T /var/cache) != zfs ]]; then
    test -c /dev/fuse
    command -v fusermount3 >/dev/null
  fi
fi
if [[ "$role" == asus ]]; then
  cat > "$stage/90-real-binary.conf" <<'UNIT'
[Service]
ExecStart=
ExecStart=/usr/local/libexec/sccache-bin/sccache
UNIT
  scheduler=/etc/sccache-dist/scheduler.conf
  record_source "$scheduler"
  assert_absent '^\s*\[(job_slack|native_cache|dashboard)(\.|\])' "$scheduler"
  assert_absent '^\s*cluster_directory\s*=' "$scheduler"
  { printf 'cluster_directory = "/var/lib/sccache-cluster/scheduler"\n'; cat -- "$scheduler"; } > "$stage/scheduler.conf"
  [[ -z "$(ss -Hln 'sport = :10602')" && -z "$(ss -Hln 'sport = :10604')" ]]
  cat >> "$stage/scheduler.conf" <<EOF

