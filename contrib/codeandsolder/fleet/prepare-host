fi
# Provision only the exact release/CI toolchains and stable smoke toolchain
# that actually exist on this host. All other toolchains use descriptor memo.
catalog_dir=/var/lib/sccache-installations/epoch6
: > "$stage/rust-installations.tsv"
home=$(getent passwd "$user" | cut -d: -f6)
for base in "$home/.rustup/toolchains" /root/.rustup/toolchains /opt/toolchains/rustup/toolchains /var/lib/sccache-native-builder/rustup/toolchains; do
  for channel in nightly-2026-11-20 nightly-2026-11-22 1.99.0; do
    root="$base/$channel-x86_64-unknown-linux-gnu"
    [[ -f "$root/lib/rustlib/multirust-config.toml" ]] || continue
    root=$(realpath -e "$root")
    id=$(printf '%s' "$root" | sha256sum | cut -c1-24)
    printf '%s\t%s\n' "$root" "$catalog_dir/$id.catalog" >> "$stage/rust-installations.tsv"
  done
done
sort -u -o "$stage/rust-installations.tsv" "$stage/rust-installations.tsv"
catalogs=$(cut -f2 "$stage/rust-installations.tsv" | jq -Rnc '[inputs]')
# Insert into the existing [dist] table, not a duplicate table.
[[ $(rg -c '^\s*\[dist\]\s*$' "$stage/client-shared.toml") == 1 ]]
assert_absent '^\s*native_installation_catalogs\s*=' "$stage/client-shared.toml"
sed -i "/^\s*\[dist\]\s*$/a native_installation_catalogs = $catalogs" "$stage/client-shared.toml"
# The live files are unchanged and must remain so until coordinated cutover.
sha256sum --check --status "$stage/originals.sha256"
printf 'role=%s\nuid=%s\ngid=%s\nplatform=%s\ncache_url=%s\n' "$role" "$uid" "$gid" "$platform" "$cache_url" > "$stage/plan.txt"
(
 cd "$stage"
 files=(*); sha256sum -- "${files[@]}" > STAGED_SHA256SUMS
 sha256sum --check --status STAGED_SHA256SUMS
)
printf 'STAGED %s uid=%s gid=%s in %s\n' "$role" "$uid" "$gid" "$stage"
