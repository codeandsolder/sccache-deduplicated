#!/usr/bin/env bash
# Stage only: all output goes into a private rollout directory. No service
# restart, live config write, cache relocation, or release promotion.
set -euo pipefail
umask 077
[[ $EUID == 0 ]]
role=${1:?acer, asus, cold-storage, or wsl}
ca_certificate=${2:?authenticated scheduler CA PEM file}
scheduler_id=${3:?scheduler public-key identity}
[[ "$scheduler_id" =~ ^[0-9a-f]{64}$ ]]
openssl x509 -in "$ca_certificate" -noout >/dev/null
if [[ "$role" == asus ]]; then
  # The CA and scheduler key must be provisioned by the scheduler account
  # before staging, not created by a root-owned rollout script.
  cmp -- "$ca_certificate" /var/lib/sccache-cluster/scheduler/ca.pem
  [[ $(openssl pkey -in /var/lib/sccache-cluster/scheduler/key.pem -pubout -outform DER | sha256sum | cut -d' ' -f1) == "$scheduler_id" ]]
fi
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
case "$role" in
  acer) user=jan; source=/etc/sccache/client.conf; worker_gib=12; worker_target=8; minimum=16; target=20 ;;
  asus) user=jan; source=/etc/sccache/client.conf; worker_gib=32; worker_target=28; minimum=32; target=36 ;;
  cold-storage) user=sentinelx; source=/etc/sccache/client.conf; worker_gib=0 ;;
  wsl) user=jan; source=/etc/sccache/config; worker_gib=12; worker_target=8; minimum=32; target=36 ;;
  *) exit 2 ;;
esac
[[ "$(systemctl show sccache-local.service -p User --value)" == "$user" ]]
uid=$(id -u "$user")
gid=$(id -g "$user")
stage=/var/lib/sccache-managed-rollout/epoch6-20261125
[[ ! -e "$stage" ]] || { echo "stage already exists: $stage"; exit 1; }
install -d -m 0700 "$stage"
trap 'rc=$?; if (( rc != 0 )); then rm -rf -- "$stage"; fi' EXIT
install -m 0600 "$ca_certificate" "$stage/cluster-ca.pem"
gib=1073741824
cache_url=https://100.73.74.69:10602
scheduler_url=https://100.73.74.69:10600
platform=linux-x86_64-zen2-explicit-codegen-bwrap-v1
record_source() { sha256sum -- "$1" >> "$stage/originals.sha256"; }
assert_absent() {
  local pattern=$1 file=$2 rc=0
  rg -q "$pattern" "$file" || rc=$?
  [[ $rc == 1 ]] || { echo "existing section or unreadable source: $file"; exit 1; }
}
record_source "$source"
assert_absent '^\s*\[(shared_daemon|dist\.native|dist\.cluster|compiler_aliases)(\.|\])' "$source"
"$repo/fleet/native-only-config" client "$source" > "$stage/client-shared.toml"
[[ $(rg -c '^\s*scheduler_url\s*=' "$stage/client-shared.toml") == 1 ]]
sed -i -E "s|^\s*scheduler_url\s*=.*$|scheduler_url = \"$scheduler_url\"|" "$stage/client-shared.toml"
cat >> "$stage/client-shared.toml" <<EOF

[dist.cluster]
directory = "/var/lib/sccache-cluster/client"
ca_certificate = "/etc/sccache/cluster-ca.pem"
scheduler_id = "$scheduler_id"

[shared_daemon]
socket_gid = $gid
allowed_uids = [$uid]

[dist.native]
endpoint = "$cache_url"
platform_contract = "$platform"
request_timeout_secs = 120
build_timeout_secs = 1800
renewal_interval_secs = 15
max_metadata_bytes = 67108864
max_result_bytes = 1073741824
EOF
case "$role" in
  acer) cat >> "$stage/client-shared.toml" <<'ALIAS_ACER'

# Candidate only; verify wrapper bytes again at activation.

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/c++"]
compiler = "/usr/bin/c++"
blake3 = "95c1fdea1ebb7afc5c1ef3b101b7013307536f29a4316ed5bb626b347c93a365"

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/cc"]
compiler = "/usr/bin/cc"
blake3 = "ca2ea427ceffe138d4e8de8b7f719e705644eb321ca04fb54511d4ab3a262928"

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/clang"]
compiler = "/usr/bin/clang"
blake3 = "3fb8ec4fd363dc7376a35eb274d6f4f08419df823ce1a80a586f839a193819fb"

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/clang++"]
compiler = "/usr/bin/clang++"
blake3 = "753e10bf8afe1ca33057f8889d4633e31a1be06c81cf40eb9eb1f3b5d9794c37"

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/clang-cl"]
compiler = "/usr/bin/clang-cl"
blake3 = "331b3a0d58fe4da0e0d958761577825bd2218241ab8f554a7a9ab1a5a6cc20a4"

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/g++"]
compiler = "/usr/bin/g++"
blake3 = "54c137db24dde0b02447856b144aeafc47737ce05193e1636e067ed3b4eac02a"

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/gcc"]
compiler = "/usr/bin/gcc"
blake3 = "66bed3c4b1899338804c28a49b88136d8644f03e6066b3e66fa036203de81d36"
ALIAS_ACER
  ;;
  asus) cat >> "$stage/client-shared.toml" <<'ALIAS_ASUS'

# Candidate only; verify wrapper bytes again at activation.

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/c++"]
compiler = "/usr/bin/c++"
blake3 = "95c1fdea1ebb7afc5c1ef3b101b7013307536f29a4316ed5bb626b347c93a365"

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/cc"]
compiler = "/usr/bin/cc"
blake3 = "ca2ea427ceffe138d4e8de8b7f719e705644eb321ca04fb54511d4ab3a262928"

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/clang"]
compiler = "/usr/bin/clang"
blake3 = "3fb8ec4fd363dc7376a35eb274d6f4f08419df823ce1a80a586f839a193819fb"

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/clang++"]
compiler = "/usr/bin/clang++"
blake3 = "753e10bf8afe1ca33057f8889d4633e31a1be06c81cf40eb9eb1f3b5d9794c37"

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/clang-cl"]
compiler = "/usr/bin/clang-cl"
blake3 = "331b3a0d58fe4da0e0d958761577825bd2218241ab8f554a7a9ab1a5a6cc20a4"

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/g++"]
compiler = "/usr/bin/g++"
blake3 = "54c137db24dde0b02447856b144aeafc47737ce05193e1636e067ed3b4eac02a"

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/gcc"]
compiler = "/usr/bin/gcc"
blake3 = "66bed3c4b1899338804c28a49b88136d8644f03e6066b3e66fa036203de81d36"

[compiler_aliases."/usr/local/libexec/sccache-strict-wrappers/nvcc"]
compiler = "/opt/cuda/bin/nvcc"
blake3 = "a0849c05a435841e8e1092ec08913e82d53e45c60d4989e78307ea5d194ee3d4"
ALIAS_ASUS
  ;;
esac
cat > "$stage/90-shared-daemon.conf" <<'UNIT'
[Service]
User=root
Group=root
ExecStart=
ExecStart=/usr/local/libexec/sccache-bin/sccache
ExecStartPre=
RuntimeDirectory=
RuntimeDirectory=sccache-shared
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
