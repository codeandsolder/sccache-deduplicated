[native_cache]
public_addr = "100.73.74.69:10602"
directory = "/var/cache/sccache-native/scheduler"
idle_timeout_secs = 120
max_sessions = 256
max_result_bytes = 1073741824
max_result_blobs = 4096
max_tree_bytes = 21474836480
max_tree_blobs = 200000
