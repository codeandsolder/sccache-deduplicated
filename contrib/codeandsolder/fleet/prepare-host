UnsetEnvironment=SCCACHE_SERVER_PORT SCCACHE_CLIENT_SIDE SCCACHE_DIST_CLIENT_CACHE_DIR
UNIT
cat > "$stage/wrapper.conf" <<'ROUTING'
user_endpoint=unix:/run/sccache-shared/sccache.sock
root_endpoint=unix:/run/sccache-shared/sccache.sock
user_service=sccache-local.service
root_service=sccache-local.service
readiness_seconds=300
ROUTING
# Use the exact reviewed host tooling from the release checkout.
install -m 0700 "$repo/sccache-client" "$stage/sccache-client"
install -m 0700 "$repo/sccache-release-update" "$stage/sccache-release-update"
install -m 0700 "$repo/host-native-metadata" "$stage/host-native-metadata"
install -m 0700 "$repo/fleet/activate-host" "$stage/activate-host"
install -m 0600 "$repo/native-action-report.awk" "$stage/native-action-report.awk"
if [[ -x /usr/bin/rustup && -f /usr/local/bin/cargo ]]; then
  install -m 0700 "$repo/cargo-wrapper" "$stage/cargo-wrapper"
fi
for helper in sccache-cmake-launcher sccache-dist-client-preflight; do
  if [[ -f "/usr/local/libexec/$helper" ]]; then
    install -m 0700 "$repo/$helper" "$stage/$helper"
  fi
done
case "$role" in
  wsl) sed -i 's| /usr/bin/rustup | /home/jan/.cargo/bin/rustup |' "$stage/sccache-client" ;;
  cold-storage) sed -i 's| /usr/bin/rustup | /var/lib/sccache-native-builder/cargo/bin/rustup |' "$stage/sccache-client" ;;
esac
chmod 0700 "$stage/sccache-client"
bash -n "$stage/sccache-client"
cat > "$stage/zz-epoch6.conf" <<'UPDATER'
[Service]
Environment=SCCACHE_AUTOUPDATE_EXPECTED_ROLLOUT_EPOCH=6
Environment=SCCACHE_AUTOUPDATE_EXPECTED_RUST_TOOLCHAIN=nightly-2026-11-20
Environment=SCCACHE_AUTOUPDATE_NATIVE_BUNDLE_ROOT=/var/lib/sccache-native-bundles
Environment=SCCACHE_AUTOUPDATE_LIVE=/usr/local/libexec/sccache-bin/sccache
Environment=SCCACHE_AUTOUPDATE_CLIENT_UDS=/run/sccache-shared/sccache.sock
UnsetEnvironment=SCCACHE_AUTOUPDATE_CLIENT_PORT
UPDATER
if (( worker_gib > 0 )); then
  worker=/etc/sccache-dist/server.conf
  record_source "$worker"
  assert_absent '^\s*\[(native_worker|cluster)(\.|\])' "$worker"
  "$repo/fleet/native-only-config" worker "$worker" "$((worker_gib*gib))" "$((worker_target*gib))" > "$stage/server.conf"
  [[ $(rg -c '^\s*scheduler_url\s*=' "$stage/server.conf") == 1 ]]
  sed -i -E "s|^\s*scheduler_url\s*=.*$|scheduler_url = \"$scheduler_url\"|; /^\s*bind_address\s*=/d" "$stage/server.conf"
  cat >> "$stage/server.conf" <<EOF

[cluster]
directory = "/var/lib/sccache-cluster/worker"
ca_certificate = "/etc/sccache/cluster-ca.pem"
scheduler_id = "$scheduler_id"

