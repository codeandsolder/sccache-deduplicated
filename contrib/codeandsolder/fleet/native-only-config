#!/usr/bin/env bash
# Convert fleet TOML generated by prepare-host or its pre-native source.
# Native clients and workers never instantiate legacy archive caches.
set -euo pipefail
mode=${1:?client or worker}
source=${2:?source TOML}
case "$mode" in
  client)
    awk '
      /^[[:space:]]*\[/ { section=$0 }
      section ~ /^[[:space:]]*\[cache\.disk\][[:space:]]*$/ { next }
      section ~ /^[[:space:]]*\[dist\][[:space:]]*$/ &&
        /^[[:space:]]*(cache_dir|toolchain_cache_size)[[:space:]]*=/ { next }
      { print }
    ' "$source"
    ;;
  worker)
    limit=${3:?maximum resident bytes}
    target=${4:?target resident bytes}
    [[ "$limit" =~ ^[0-9]+$ && "$target" =~ ^[0-9]+$ && "$target" -gt 0 && "$target" -le "$limit" ]]
    awk -v limit="$limit" -v target="$target" '
      /^[[:space:]]*\[/ {
        section=$0
        if (section ~ /^[[:space:]]*\[builder\][[:space:]]*$/) {
          print "[builder]"
          print "type = \"native\""
          next
        }
      }
      section == "" &&
        /^[[:space:]]*(cache_dir|toolchain_cache_size|toolchain_archive_sources)[[:space:]]*=/ { next }
      section ~ /^[[:space:]]*\[builder\][[:space:]]*$/ { next }
      section ~ /^[[:space:]]*\[native_worker\.space\][[:space:]]*$/ {
        if ($0 ~ /^[[:space:]]*max_resident_bytes[[:space:]]*=/) {
          print "max_resident_bytes = " limit
          next
        }
        if ($0 ~ /^[[:space:]]*target_resident_bytes[[:space:]]*=/) {
          print "target_resident_bytes = " target
          next
        }
      }
      { print }
    ' "$source"
    ;;
  *) exit 2 ;;
esac
