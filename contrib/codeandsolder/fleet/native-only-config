#!/usr/bin/env bash
# Convert fleet TOML generated by prepare-host or its pre-native source.
# Native clients and workers never instantiate legacy archive caches.
set -euo pipefail
mode=${1:?client or worker}
source=${2:?source TOML}
case "$mode" in
  client)
    # An archive override used to change which compiler actually executed.
    # Do not silently reinterpret such a configuration as the host compiler.
    if ! awk '
      /^[[:space:]]*\[\[/ && /dist\.toolchains/ { exit 1 }
      /^[[:space:]]*\[/ { section=$0 }
      section ~ /^[[:space:]]*\[dist\][[:space:]]*$/ &&
        /^[[:space:]]*toolchains[[:space:]]*=/ &&
        $0 !~ /^[[:space:]]*toolchains[[:space:]]*=[[:space:]]*\[[[:space:]]*\][[:space:]]*(#.*)?$/ { exit 1 }
    ' "$source"; then
      echo "Archive toolchain overrides must be replaced with native toolchain provisioning before migration" >&2
      exit 1
    fi
    awk '
      /^[[:space:]]*\[/ { section=$0 }
      section ~ /^[[:space:]]*\[cache([.][^]]+)?\][[:space:]]*$/ { next }
      section ~ /^[[:space:]]*\[dist\][[:space:]]*$/ &&
        /^[[:space:]]*(cache_dir|toolchain_cache_size|rewrite_includes_only|toolchains)[[:space:]]*=/ { next }
      { print }
    ' "$source"
    ;;
  worker)
    limit=${3:?maximum resident bytes}
    target=${4:?target resident bytes}
    [[ "$limit" =~ ^[0-9]+$ && "$target" =~ ^[0-9]+$ && "$target" -gt 0 && "$target" -le "$limit" ]]
    awk -v limit="$limit" -v target="$target" '
      /^[[:space:]]*\[/ {
        section=$0
        if (section ~ /^[[:space:]]*\[builder\][[:space:]]*$/) {
          print "[builder]"
          print "type = \"native\""
          next
        }
      }
      section == "" &&
        /^[[:space:]]*(cache_dir|toolchain_cache_size|toolchain_archive_sources)[[:space:]]*=/ { next }
      section ~ /^[[:space:]]*\[builder\][[:space:]]*$/ { next }
      section ~ /^[[:space:]]*\[native_worker\.space\][[:space:]]*$/ {
        if ($0 ~ /^[[:space:]]*max_resident_bytes[[:space:]]*=/) {
          print "max_resident_bytes = " limit
          next
        }
        if ($0 ~ /^[[:space:]]*target_resident_bytes[[:space:]]*=/) {
          print "target_resident_bytes = " target
          next
        }
      }
      { print }
    ' "$source"
    ;;
  *) exit 2 ;;
esac
