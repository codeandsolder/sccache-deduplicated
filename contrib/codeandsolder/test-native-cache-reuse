#!/usr/bin/env bash
# Managed native CAS acceptance test for the complete BoringSSL build.
# No additional cache daemon, cache storage, or global counter resets.
set -euo pipefail

die() { printf '%s\n' "$*" >&2; exit 1; }

# Each trace belongs to one real compiler invocation. Accept only the
# terminal native action report returned by the managed server, not aggregate
# counters, compiler stderr guesses, or legacy RPC discriminants.
lookup() {
    local mode=${2:-reuse}
    awk -v mode="$mode" -f "$(dirname -- "${BASH_SOURCE[0]}")/native-action-report.awk" "$1"
}

trace_compile() {
    local output='' trace i
    local args=("$@")
    for ((i=0;i<${#args[@]};i++)); do
        if [[ ${args[i]} == -o ]]; then output=${args[i+1]}; break; fi
    done
    [[ -n $output && $output != /* && $output != *..* ]] || die "Unexpected CMake output: $output"
    trace="$OUT_DIR/trace/$output.log"
    mkdir -p "$(dirname "$trace")"
    unset SCCACHE_ERROR_LOG SCCACHE_LOG_MILLIS SCCACHE_CLIENT_SIDE
    export SCCACHE_LOG=sccache::native_action=info
    local status=0
    "$@" 2>"$trace" || status=$?
    cat "$trace" >&2
    return "$status"
}

manifest() {
    (cd "$1/build"
        find CMakeFiles/{crypto,ssl,fipsmodule}.dir -name '*.o' -type f -print0 |
            sort -z | xargs -0 -r sha256sum
        sha256sum libcrypto.a libssl.a
    )
}

summarize() {
    local root=$1 mode=${2:-reuse} file object result n=0
    while IFS= read -r -d '' file; do
        object=${file#"$root/build/"}
        result=$(lookup "$root/trace/$object.log" "$mode") || die "Unusable trace for $object"
        printf '%s %s\n' "$object" "$result"
        if [[ $object == *.cc.o || $object == *.cpp.o || $object == *.c.o ]]; then
            rg -q -F "$root/boringssl/" "$file.d" || die "Wrong depfile root: $object"
            if rg -q -F '/__sccache/' "$file.d"; then die "Canonical name in depfile: $object"; fi
        fi
        n=$((n+1))
    done < <(find "$root/build/CMakeFiles/"{crypto,ssl,fipsmodule}.dir -name '*.o' -type f -print0 | sort -z)
    [[ $n -gt 0 && $n -eq $(find "$root/trace" -name '*.log' -type f | wc -l) ]] ||
        die "Object and compiler trace counts differ at $root"
}

verify() {
    local a=$1 b=$2 expected=$3 results=$4
    summarize "$a" > "$results/a.lookups"
    summarize "$b" > "$results/b.lookups"
    for phase in a b; do
        [[ $(wc -l < "$results/$phase.lookups") -eq $expected ]] || die "Unexpected workload size in $phase"
        awk '{n[$3]++} END {for(k in n) print k,n[k]}' "$results/$phase.lookups"
    done
    diff -u <(cut -d' ' -f1,2 "$results/a.lookups") <(cut -d' ' -f1,2 "$results/b.lookups")
    awk '$3 != "hit" {print; failed=1} END {exit failed}' "$results/b.lookups"
    manifest "$a" > "$results/a.sha256"
    manifest "$b" > "$results/b.sha256"
    diff -u "$results/a.sha256" "$results/b.sha256"
    printf '%s matching keys, all second-pass cache hits; matching artifacts\n' "$expected"
}

if [[ ${1:-} == --self-test ]]; then
    key=$(printf '%064d' 0)
    line="[2026-11-25T00:00:00Z INFO  sccache::native_action] native_action $key"
    [[ $(printf '%s hit reuse\n' "$line" | lookup /dev/stdin) == "$key hit" ]]
    [[ $(printf '%s worker refresh\n' "$line" | lookup /dev/stdin refresh) == "$key miss" ]]
    if printf '%s hit refresh\n' "$line" | lookup /dev/stdin refresh; then exit 1; fi
    if printf '%s worker reuse\n%s hit reuse\n' "$line" "$line" | lookup /dev/stdin; then exit 1; fi
    if printf 'no report\n' | lookup /dev/stdin; then exit 1; fi
    echo native-action-report-parser-pass
    exit
fi
if [[ ${1:-} == --trace-compile ]]; then shift; trace_compile "$@"; fi
if [[ ${1:-} == --lookup ]]; then [[ $# == 2 || $# == 3 ]] || die "Usage: --lookup TRACE [reuse|refresh]"; lookup "$2" "${3:-reuse}"; exit; fi
if [[ ${1:-} == --verify ]]; then
    [[ $# == 5 ]] || die "Usage: --verify OUT_A OUT_B EXPECTED_COUNT RESULTS_DIR"
    verify "$2" "$3" "$4" "$5"; exit
fi
[[ $# -ge 3 ]] || die "Usage: $0 PATCHED_BORINGSSL_SOURCE WORKSPACE EXPECTED_COUNT [actual CMake options...]"
source=$(realpath "$1")
workspace=$(realpath "$2")
expected=$3
shift 3
[[ -f $source/CMakeLists.txt && -d $workspace && $expected =~ ^[1-9][0-9]*$ ]] || die "Invalid source, workspace or count"
[[ -n ${CARGO_MANIFEST_DIR:-} && -n ${SCCACHE_CANONICAL_TARGET_ROOT:-} ]] || die "Provide the actual Cargo build-script environment"
script=$(realpath "$0")
[[ $workspace =~ ^[a-zA-Z0-9_./-]+$ && $script =~ ^[a-zA-Z0-9_./-]+$ ]] || die "Unsupported workspace or script path"
unset SCCACHE_RECACHE SCCACHE_CLIENT_SIDE
scratch=$(mktemp -d "$workspace/native-cache-reuse.XXXXXXXX")
echo "Acceptance directory: $scratch"
# Preserve small raw evidence, remove only our copied source/build trees.
trap 'rm -rf -- "$scratch/a" "$scratch/b"' EXIT
for phase in a b; do
    if [[ $phase == a ]]; then fingerprint=bd00da2a08bc0b6a; else fingerprint=72223245a454eaef; fi
    root="$scratch/$phase/workspace-$phase"
    export OUT_DIR="$root/debug/build/boring-sys/$fingerprint/out"
    export SCCACHE_EXPERIMENTAL_CANONICAL_RUST=1
    mkdir -p "$OUT_DIR"
    printf 'Signature: 8a477f597d28d172789f06886806bc55\n' > "$root/CACHEDIR.TAG"
    cp -a "$source" "$OUT_DIR/boringssl"
    # Use the original build-script compiler/launcher/flag options passed by
    # the caller. Both independent source copies are real builds, not replayed
    # preprocessed inputs or a selected sample.
    cmake -S "$OUT_DIR/boringssl" -B "$OUT_DIR/build" -G 'Unix Makefiles' \
        -DCMAKE_INSTALL_PREFIX="$OUT_DIR" "$@" > "$scratch/$phase-configure.log" 2>&1
    for target in fipsmodule crypto ssl; do
        rule="$OUT_DIR/build/CMakeFiles/$target.dir/build.make"
        [[ -f $rule ]] || die "Missing CMake target rule: $rule"
        sed -i -E "s|^(\t)(.* -c .*)$|\1$script --trace-compile \2|" "$rule"
    done
    cmake --build "$OUT_DIR/build" --target ssl crypto --parallel "${JOBS:-8}" > "$scratch/$phase-build.log" 2>&1
    printf '%s\n' "$OUT_DIR" > "$scratch/$phase.root"
done
a=$(cat "$scratch/a.root"); b=$(cat "$scratch/b.root")
verify "$a" "$b" "$expected" "$scratch"
# Verify the returned bytes against a genuine normal-mode fresh compilation.
# Forced recache does not bypass sccache or create a new daemon.
export OUT_DIR="$b"
unset SCCACHE_CLIENT_SIDE
rm -rf -- "$b/trace"
SCCACHE_RECACHE=1 cmake --build "$b/build" --clean-first --target ssl crypto \
    --parallel "${JOBS:-8}" > "$scratch/fresh-build.log" 2>&1
summarize "$b" refresh > "$scratch/fresh.lookups"
diff -u <(cut -d' ' -f1,2 "$scratch/b.lookups") <(cut -d' ' -f1,2 "$scratch/fresh.lookups")
awk '$3 != "miss" {failed=1} END {exit failed}' "$scratch/fresh.lookups"
manifest "$b" > "$scratch/fresh.sha256"
diff -u "$scratch/b.sha256" "$scratch/fresh.sha256"
printf 'All %s fresh object files and both archives equal cached bytes\n' "$expected"

# A single genuine source mutation must change the key and the object. Use an
# independent symbol name to ensure this cannot hit a previous test mutation.
object=CMakeFiles/crypto.dir/crypto/bytestring/cbs.cc.o
source_file="$b/boringssl/crypto/bytestring/cbs.cc"
rule="$b/build/CMakeFiles/crypto.dir/build.make"
[[ -f $source_file && -f $b/build/$object ]] || die "Missing mutation fixture"
symbol="sccache_acceptance_mutation_${scratch##*.}"
printf '\nextern "C" __attribute__((used)) int %s() { return 303; }\n' "$symbol" >> "$source_file"
rm -- "$b/build/$object" "$b/trace/$object.log"
make -C "$b/build" -f CMakeFiles/crypto.dir/build.make "$object" > "$scratch/mutation-build.log" 2>&1
result=$(lookup "$b/trace/$object.log") || die "Missing mutation lookup"
old_key=$(awk -v object="$object" '$1 == object { print $2 }' "$scratch/b.lookups")
[[ -n $old_key && ${result% *} != "$old_key" && ${result##* } == miss ]] || die "Mutation did not create a new cache key"
nm "$b/build/$object" | rg -q " T $symbol$" || die "Mutation symbol missing from object"
printf '%s %s\n' "$object" "$result" > "$scratch/mutation.lookup"
echo 'Source mutation changed the key, missed and produced the new symbol'
