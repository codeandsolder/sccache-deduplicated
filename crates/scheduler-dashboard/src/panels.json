[
  {
    "title": "Cache tier capacity (shared tiers repeat per client)",
    "kind": "timeseries",
    "unit": "bytes",
    "queries": [
      {
        "expr": "sccache_cache_tier_size_bytes{instance=~\"$client\",resolution=\"raw\"}",
        "legend": "{{instance}} L{{level}} {{backend}} {{kind}}"
      }
    ]
  },
  {
    "title": "Legacy serialized object sizes (bytes per bucket)",
    "kind": "bargauge",
    "unit": "bytes",
    "queries": [
      {
        "expr": "sccache_cache_tier_distribution_bytes{instance=~\"$client\",resolution=\"raw\",dimension=\"size\"}",
        "legend": "{{instance}} L{{level}} {{backend}} {{upper}}"
      }
    ],
    "requires_client": true
  },
  {
    "title": "Legacy serialized object sizes (objects per bucket)",
    "kind": "bargauge",
    "unit": "short",
    "queries": [
      {
        "expr": "sccache_cache_tier_distribution_objects{instance=~\"$client\",resolution=\"raw\",dimension=\"size\"}",
        "legend": "{{instance}} L{{level}} {{backend}} {{upper}}"
      }
    ],
    "requires_client": true
  },
  {
    "title": "Legacy last-access age (bytes per bucket)",
    "kind": "bargauge",
    "unit": "bytes",
    "queries": [
      {
        "expr": "sccache_cache_tier_distribution_bytes{instance=~\"$client\",resolution=\"raw\",dimension=\"age\"}",
        "legend": "{{instance}} L{{level}} {{backend}} {{upper}}"
      }
    ],
    "requires_client": true
  },
  {
    "title": "Managed decayed heat, milli-hits (bytes per bucket)",
    "kind": "bargauge",
    "unit": "bytes",
    "queries": [
      {
        "expr": "sccache_cache_tier_distribution_bytes{instance=~\"$client\",resolution=\"raw\",dimension=\"heat\"}",
        "legend": "{{instance}} L{{level}} {{backend}} {{upper}}"
      }
    ],
    "requires_client": true
  },
  {
    "title": "Managed eviction-adjusted age (bytes per bucket)",
    "kind": "bargauge",
    "unit": "bytes",
    "queries": [
      {
        "expr": "sccache_cache_tier_distribution_bytes{instance=~\"$client\",resolution=\"raw\",dimension=\"policy_age\"}",
        "legend": "{{instance}} L{{level}} {{backend}} {{upper}}"
      }
    ],
    "requires_client": true
  },
  {
    "title": "Managed heat percentile storage share (bounds)",
    "kind": "stat",
    "unit": "percent",
    "queries": [
      {
        "expr": "sccache_cache_tier_heat_storage_share_percent{instance=~\"$client\",resolution=\"raw\"}",
        "legend": "{{instance}} L{{level}} {{backend}} p{{percentile}} {{bound}}"
      }
    ],
    "requires_client": true
  },
  {
    "title": "Legacy analytics snapshot age (seconds)",
    "kind": "stat",
    "unit": "short",
    "queries": [
      {
        "expr": "time()-sccache_cache_tier_snapshot_timestamp_seconds{instance=~\"$client\",resolution=\"raw\"}",
        "legend": "{{instance}} L{{level}} {{backend}}"
      }
    ]
  },
  {
    "title": "Reported cache size by client (shared tiers may repeat)",
    "kind": "timeseries",
    "unit": "bytes",
    "queries": [
      {
        "expr": "sccache_cache_size_bytes{instance=~\"$client\",resolution=\"raw\"}",
        "legend": "{{instance}} {{kind}}"
      }
    ]
  },
  {
    "title": "Workers",
    "kind": "stat",
    "unit": "short",
    "queries": [
      {
        "expr": "max(sccache_dist_status{resolution=\"raw\",kind=\"servers\"})",
        "legend": ""
      }
    ]
  },
  {
    "title": "Advertised CPUs",
    "kind": "stat",
    "unit": "short",
    "queries": [
      {
        "expr": "max(sccache_dist_status{resolution=\"raw\",kind=\"cpus\"})",
        "legend": ""
      }
    ]
  },
  {
    "title": "Jobs in progress",
    "kind": "stat",
    "unit": "short",
    "queries": [
      {
        "expr": "max(sccache_dist_status{resolution=\"raw\",kind=\"in_progress\"})",
        "legend": ""
      }
    ]
  },
  {
    "title": "Cluster occupancy",
    "kind": "stat",
    "unit": "percent",
    "queries": [
      {
        "expr": "100*max(sccache_dist_status{resolution=\"raw\",kind=\"in_progress\"})/clamp_min(max(sccache_dist_status{resolution=\"raw\",kind=\"cpus\"}),1)",
        "legend": ""
      }
    ]
  },
  {
    "title": "Connected monitored clients",
    "kind": "stat",
    "unit": "short",
    "queries": [
      {
        "expr": "sum(sccache_dist_status{instance=~\"$client\",resolution=\"raw\",kind=\"connected\"})",
        "legend": ""
      }
    ]
  },
  {
    "title": "Cache hit rate (rolling)",
    "kind": "stat",
    "unit": "percent",
    "queries": [
      {
        "expr": "((100*(sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=\"hit\"}[5m])) or (0*sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[5m]))))/sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[5m]))) and (sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[5m]))>0))",
        "legend": "5 min"
      },
      {
        "expr": "((100*(sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=\"hit\"}[15m])) or (0*sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[15m]))))/sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[15m]))) and (sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[15m]))>0))",
        "legend": "15 min"
      },
      {
        "expr": "((100*(sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=\"hit\"}[1h])) or (0*sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[1h]))))/sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[1h]))) and (sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[1h]))>0))",
        "legend": "1 hour"
      },
      {
        "expr": "((100*(sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=\"hit\"}[24h])) or (0*sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[24h]))))/sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[24h]))) and (sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[24h]))>0))",
        "legend": "24 hours"
      },
      {
        "expr": "((100*(sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=\"hit\"}[$__range])) or (0*sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__range]))))/sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__range]))) and (sum(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__range]))>0))",
        "legend": "Selected range"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Distributed share (range)",
    "kind": "stat",
    "unit": "percent",
    "queries": [
      {
        "expr": "100*sum(increase(sccache_dist_compiles_total{instance=~\"$client\",resolution=\"raw\"}[$__range]))/clamp_min(sum(increase(sccache_compilations_total{instance=~\"$client\",resolution=\"raw\",result=\"performed\"}[$__range])),1)",
        "legend": ""
      }
    ]
  },
  {
    "title": "Dist errors (1h)",
    "kind": "stat",
    "unit": "short",
    "queries": [
      {
        "expr": "sum(increase(sccache_dist_events_total{instance=~\"$client\",resolution=\"raw\",event=\"error\"}[1h]))",
        "legend": ""
      }
    ]
  },
  {
    "title": "Request throughput",
    "kind": "timeseries",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(instance)(rate(sccache_requests_total{instance=~\"$client\",resolution=\"raw\",result=\"compile\"}[$__rate_interval]))",
        "legend": "{{instance}} compile/s"
      },
      {
        "expr": "sum by(instance)(rate(sccache_requests_total{instance=~\"$client\",resolution=\"raw\",result=\"executed\"}[$__rate_interval]))",
        "legend": "{{instance}} executed/s"
      }
    ]
  },
  {
    "title": "Cache requests",
    "kind": "timeseries",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(instance,result)(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\"}[$__rate_interval]))",
        "legend": "{{instance}} {{result}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Distributed compiles by worker",
    "kind": "timeseries",
    "unit": "ops",
    "queries": [
      {
        "expr": "((label_replace((sum by(server)(rate(sccache_dist_compiles_total{instance=~\"$client\",resolution=\"raw\"}[$__rate_interval]))), \"tailscale_ip\", \"$1\", \"server\", \"([^:]+):.*\")) * on(tailscale_ip) group_left(hostname) (max by(tailscale_ip,hostname) ({__name__=~\"tailscale_(peer|self)_info\",resolution=\"raw\",tailscale_ip!=\"\"}))) or (label_replace(((label_replace((sum by(server)(rate(sccache_dist_compiles_total{instance=~\"$client\",resolution=\"raw\"}[$__rate_interval]))), \"tailscale_ip\", \"$1\", \"server\", \"([^:]+):.*\")) unless on(tailscale_ip) (max by(tailscale_ip,hostname) ({__name__=~\"tailscale_(peer|self)_info\",resolution=\"raw\",tailscale_ip!=\"\"}))), \"hostname\", \"$1\", \"server\", \"(.*)\"))",
        "legend": "{{hostname}}"
      }
    ]
  },
  {
    "title": "Cache hit rate by language",
    "kind": "timeseries",
    "unit": "percent",
    "queries": [
      {
        "expr": "((100*(sum by(language)(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=\"hit\"}[$__rate_interval])) or (0*sum by(language)(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__rate_interval]))))/sum by(language)(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__rate_interval]))) and (sum by(language)(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__rate_interval]))>0))",
        "legend": "{{language}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Non-cacheable reasons",
    "kind": "timeseries",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(reason)(rate(sccache_not_cached_total{instance=~\"$client\",resolution=\"raw\"}[$__rate_interval]))",
        "legend": "{{reason}}"
      },
      {
        "expr": "sum by(crate_type)(rate(sccache_not_cached_crate_types_total{instance=~\"$client\",resolution=\"raw\"}[$__rate_interval]))",
        "legend": "crate-type: {{crate_type}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Request disposition",
    "kind": "timeseries",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(instance,result)(rate(sccache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"executed|not_cacheable|unsupported_compiler|not_compile\"}[$__rate_interval]))",
        "legend": "{{instance}} {{result}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Average compile time",
    "kind": "timeseries",
    "unit": "s",
    "queries": [
      {
        "expr": "sum by(instance)(rate(sccache_duration_seconds_total{instance=~\"$client\",resolution=\"raw\",operation=\"compile\"}[$__rate_interval]))/clamp_min(sum by(instance)(rate(sccache_compilations_total{instance=~\"$client\",resolution=\"raw\",result=\"performed\"}[$__rate_interval])),1e-9)",
        "legend": "{{instance}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Cache operation latency",
    "kind": "timeseries",
    "unit": "s",
    "queries": [
      {
        "expr": "sum by(instance)(rate(sccache_duration_seconds_total{instance=~\"$client\",resolution=\"raw\",operation=\"cache_write\"}[$__rate_interval]))/clamp_min(sum by(instance)(rate(sccache_cache_events_total{instance=~\"$client\",resolution=\"raw\",event=\"write\"}[$__rate_interval])),1e-9)",
        "legend": "{{instance}} write"
      },
      {
        "expr": "sum by(instance)(rate(sccache_duration_seconds_total{instance=~\"$client\",resolution=\"raw\",operation=\"cache_read_hit\"}[$__rate_interval]))/clamp_min(sum by(instance)(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=\"hit\"}[$__rate_interval])),1e-9)",
        "legend": "{{instance}} read hit"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "L0 cache latency",
    "kind": "timeseries",
    "unit": "s",
    "queries": [
      {
        "expr": "sum by(instance,name)(rate(sccache_cache_level_duration_seconds_total{instance=~\"$client\",resolution=\"raw\",operation=\"write\"}[$__rate_interval]))/clamp_min(sum by(instance,name)(rate(sccache_cache_level_operations_total{instance=~\"$client\",resolution=\"raw\",operation=\"write\"}[$__rate_interval])),1e-9)",
        "legend": "{{instance}} {{name}} write"
      },
      {
        "expr": "sum by(instance,name)(rate(sccache_cache_level_duration_seconds_total{instance=~\"$client\",resolution=\"raw\",operation=\"hit\"}[$__rate_interval]))/clamp_min(sum by(instance,name)(rate(sccache_cache_level_operations_total{instance=~\"$client\",resolution=\"raw\",operation=\"hit\"}[$__rate_interval])),1e-9)",
        "legend": "{{instance}} {{name}} hit"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Cache-level operations",
    "kind": "timeseries",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(instance,name,operation)(rate(sccache_cache_level_operations_total{instance=~\"$client\",resolution=\"raw\"}[$__rate_interval]))",
        "legend": "{{instance}} {{name}} {{operation}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Cache errors / unusual events",
    "kind": "timeseries",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(instance,event)(rate(sccache_cache_events_total{instance=~\"$client\",resolution=\"raw\",event=~\"timeout|read_error|write_error|forced_recache|non_cacheable_compilation\"}[$__rate_interval]))",
        "legend": "{{instance}} {{event}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Compile & distributed failures",
    "kind": "timeseries",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(instance)(rate(sccache_compilations_total{instance=~\"$client\",resolution=\"raw\",result=\"failed\"}[$__rate_interval]))",
        "legend": "{{instance}} compile failures/s"
      },
      {
        "expr": "sum by(instance)(rate(sccache_dist_events_total{instance=~\"$client\",resolution=\"raw\",event=\"error\"}[$__rate_interval]))",
        "legend": "{{instance}} dist errors/s"
      }
    ]
  },
  {
    "title": "Distributed compiles in selected range",
    "kind": "bargauge",
    "unit": "short",
    "queries": [
      {
        "expr": "((label_replace((sum by(server)(increase(sccache_dist_compiles_total{instance=~\"$client\",resolution=\"raw\"}[$__range]))), \"tailscale_ip\", \"$1\", \"server\", \"([^:]+):.*\")) * on(tailscale_ip) group_left(hostname) (max by(tailscale_ip,hostname) ({__name__=~\"tailscale_(peer|self)_info\",resolution=\"raw\",tailscale_ip!=\"\"}))) or (label_replace(((label_replace((sum by(server)(increase(sccache_dist_compiles_total{instance=~\"$client\",resolution=\"raw\"}[$__range]))), \"tailscale_ip\", \"$1\", \"server\", \"([^:]+):.*\")) unless on(tailscale_ip) (max by(tailscale_ip,hostname) ({__name__=~\"tailscale_(peer|self)_info\",resolution=\"raw\",tailscale_ip!=\"\"}))), \"hostname\", \"$1\", \"server\", \"(.*)\"))",
        "legend": "{{hostname}}"
      }
    ]
  },
  {
    "title": "Certifex scheduler ingress",
    "kind": "timeseries",
    "unit": "reqps",
    "queries": [
      {
        "expr": "sum by(status_class)(rate(certifex_proxy_requests_total{host=\"$ingress_host\",resolution=\"raw\"}[$__rate_interval]))",
        "legend": "{{status_class}}"
      }
    ]
  },
  {
    "title": "Certifex backend failures",
    "kind": "timeseries",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum(rate(certifex_backend_failures_total{host=\"$ingress_host\",resolution=\"raw\"}[$__rate_interval]))",
        "legend": "backend failures/s"
      }
    ]
  },
  {
    "title": "Metrics freshness",
    "kind": "timeseries",
    "unit": "s",
    "queries": [
      {
        "expr": "time()-metrics_push_last_success_unixtime{instance=~\"$client\",resolution=\"raw\"}",
        "legend": "{{instance}}"
      }
    ]
  },
  {
    "title": "Preprocessor cache mode",
    "kind": "stat",
    "unit": "bool",
    "queries": [
      {
        "expr": "max(sccache_preprocessor_cache_mode{instance=~\"$client\",resolution=\"raw\"})",
        "legend": ""
      }
    ]
  },
  {
    "title": "Cache levels",
    "kind": "stat",
    "unit": "short",
    "queries": [
      {
        "expr": "max(sccache_cache_levels{instance=~\"$client\",resolution=\"raw\"})",
        "legend": ""
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Basedirs",
    "kind": "stat",
    "unit": "short",
    "queries": [
      {
        "expr": "max(sccache_basedirs{instance=~\"$client\",resolution=\"raw\"})",
        "legend": ""
      }
    ]
  },
  {
    "title": "Versions",
    "kind": "table",
    "unit": "",
    "queries": [
      {
        "expr": "sccache_info{instance=~\"$client\",resolution=\"raw\"}",
        "legend": "{{instance}} {{version}}"
      }
    ]
  },
  {
    "title": "Linux host CPU busy",
    "kind": "timeseries",
    "unit": "percent",
    "queries": [
      {
        "expr": "100*sum by(instance)(rate(cpu_seconds_total{instance=~\".+\",resolution=\"raw\",cpu=\"total\",mode!~\"idle|iowait\"}[$__rate_interval]))/clamp_min(sum by(instance)(rate(cpu_seconds_total{instance=~\".+\",resolution=\"raw\",cpu=\"total\"}[$__rate_interval])),1e-9)",
        "legend": "{{instance}}"
      }
    ]
  },
  {
    "title": "Linux host memory used",
    "kind": "timeseries",
    "unit": "percent",
    "queries": [
      {
        "expr": "100*(1-meminfo{instance=~\".+\",resolution=\"raw\",field=\"mem_available\"}/ignoring(field) meminfo{instance=~\".+\",resolution=\"raw\",field=\"mem_total\"})",
        "legend": "{{instance}}"
      }
    ]
  },
  {
    "title": "Linux host load",
    "kind": "timeseries",
    "unit": "short",
    "queries": [
      {
        "expr": "load_average{instance=~\".+\",resolution=\"raw\",interval=\"1\"}",
        "legend": "{{instance}}"
      }
    ]
  },
  {
    "title": "Compiler/language cache hit rate",
    "kind": "timeseries",
    "unit": "percent",
    "queries": [
      {
        "expr": "((100*(sum by(compiler_language)(rate(sccache_cache_requests_advanced_total{instance=~\"$client\",resolution=\"raw\",result=\"hit\"}[$__rate_interval])) or (0*sum by(compiler_language)(rate(sccache_cache_requests_advanced_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__rate_interval]))))/sum by(compiler_language)(rate(sccache_cache_requests_advanced_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__rate_interval]))) and (sum by(compiler_language)(rate(sccache_cache_requests_advanced_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__rate_interval]))>0))",
        "legend": "{{compiler_language}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Compiler/language cache requests",
    "kind": "timeseries",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(compiler_language,result)(rate(sccache_cache_requests_advanced_total{instance=~\"$client\",resolution=\"raw\"}[$__rate_interval]))",
        "legend": "{{compiler_language}} {{result}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Completed cache results · selected range",
    "kind": "stat",
    "unit": "short",
    "queries": [
      {
        "expr": "sum by(result)(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss|error\"}[$__range]))",
        "legend": "{{result}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Completed cache hit rate · client history",
    "kind": "timeseries",
    "unit": "percent",
    "queries": [
      {
        "expr": "((100*(sum by(instance)(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=\"hit\"}[$__rate_interval])) or (0*sum by(instance)(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__rate_interval]))))/sum by(instance)(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__rate_interval]))) and (sum by(instance)(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__rate_interval]))>0))",
        "legend": "{{instance}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Completed cache hit rate · selected range by client",
    "kind": "stat",
    "unit": "percent",
    "queries": [
      {
        "expr": "((100*(sum by(instance)(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=\"hit\"}[$__range])) or (0*sum by(instance)(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__range]))))/sum by(instance)(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__range]))) and (sum by(instance)(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__range]))>0))",
        "legend": "{{instance}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Completed results by client · selected range",
    "kind": "stat",
    "unit": "short",
    "queries": [
      {
        "expr": "sum by(instance,result)(increase(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\"}[$__range]))",
        "legend": "{{instance}} {{result}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Completed results by compiler · selected range",
    "kind": "stat",
    "unit": "short",
    "queries": [
      {
        "expr": "sum by(compiler_language,result)(increase(sccache_cache_requests_advanced_total{instance=~\"$client\",resolution=\"raw\"}[$__range]))",
        "legend": "{{compiler_language}} {{result}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Legacy tier lookups · selected range",
    "kind": "stat",
    "unit": "short",
    "queries": [
      {
        "expr": "sum by(instance,level,name,operation)(increase(sccache_cache_level_operations_total{instance=~\"$client\",resolution=\"raw\",operation=~\"hit|miss|read_error\"}[$__range]))",
        "legend": "{{instance}} L{{level}} {{name}} {{operation}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Cache bypasses and errors · selected range",
    "kind": "stat",
    "unit": "short",
    "queries": [
      {
        "expr": "sum by(event)(increase(sccache_cache_events_total{instance=~\"$client\",resolution=\"raw\",event=~\"timeout|read_error|write_error|forced_recache|non_cacheable_compilation\"}[$__range]))",
        "legend": "{{event}}"
      },
      {
        "expr": "sum by(reason)(increase(sccache_not_cached_total{instance=~\"$client\",resolution=\"raw\"}[$__range]))",
        "legend": "{{reason}}"
      }
    ],
    "cache_hits": true
  },
  {
    "title": "Completed cache hit rate · fleet history",
    "kind": "timeseries",
    "unit": "percent",
    "queries": [
      {
        "expr": "((100*(sum(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=\"hit\"}[$__rate_interval])) or (0*sum(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__rate_interval]))))/sum(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__rate_interval]))) and (sum(rate(sccache_cache_requests_total{instance=~\"$client\",resolution=\"raw\",result=~\"hit|miss\"}[$__rate_interval]))>0))",
        "legend": "All selected clients"
      }
    ],
    "cache_hits": true
  }
]
