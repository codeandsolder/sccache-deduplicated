[
  {
    "title": "Workers",
    "unit": "short",
    "queries": [
      {
        "expr": "max(sccache_dist_status{resolution=\"raw\",kind=\"servers\"})",
        "legend": ""
      }
    ]
  },
  {
    "title": "Advertised CPUs",
    "unit": "short",
    "queries": [
      {
        "expr": "max(sccache_dist_status{resolution=\"raw\",kind=\"cpus\"})",
        "legend": ""
      }
    ]
  },
  {
    "title": "Jobs in progress",
    "unit": "short",
    "queries": [
      {
        "expr": "max(sccache_dist_status{resolution=\"raw\",kind=\"in_progress\"})",
        "legend": ""
      }
    ]
  },
  {
    "title": "Cluster occupancy",
    "unit": "percent",
    "queries": [
      {
        "expr": "100*max(sccache_dist_status{resolution=\"raw\",kind=\"in_progress\"})/clamp_min(max(sccache_dist_status{resolution=\"raw\",kind=\"cpus\"}),1)",
        "legend": ""
      }
    ]
  },
  {
    "title": "Connected monitored clients",
    "unit": "short",
    "queries": [
      {
        "expr": "sum(sccache_dist_status{instance=~\".*\",resolution=\"raw\",kind=\"connected\"})",
        "legend": ""
      }
    ]
  },
  {
    "title": "Cache hit rate (rolling)",
    "unit": "percent",
    "queries": [
      {
        "expr": "(100*sum(increase(sccache_cache_requests_total{instance=~\".*\",resolution=\"raw\",result=\"hit\"}[5m]))/clamp_min(sum(increase(sccache_cache_requests_total{instance=~\".*\",resolution=\"raw\",result=~\"hit|miss\"}[5m])),1)) and (sum(increase(sccache_cache_requests_total{instance=~\".*\",resolution=\"raw\",result=~\"hit|miss\"}[5m])) > 0)",
        "legend": "5m"
      },
      {
        "expr": "(100*sum(increase(sccache_cache_requests_total{instance=~\".*\",resolution=\"raw\",result=\"hit\"}[15m]))/clamp_min(sum(increase(sccache_cache_requests_total{instance=~\".*\",resolution=\"raw\",result=~\"hit|miss\"}[15m])),1)) and (sum(increase(sccache_cache_requests_total{instance=~\".*\",resolution=\"raw\",result=~\"hit|miss\"}[15m])) > 0)",
        "legend": "15m"
      },
      {
        "expr": "100*sum(sccache_cache_requests_total{instance=~\".*\",resolution=\"raw\",result=\"hit\"})/clamp_min(sum(sccache_cache_requests_total{instance=~\".*\",resolution=\"raw\",result=~\"hit|miss\"}),1)",
        "legend": "since restart"
      }
    ]
  },
  {
    "title": "Distributed share (range)",
    "unit": "percent",
    "queries": [
      {
        "expr": "100*sum(increase(sccache_dist_compiles_total{instance=~\".*\",resolution=\"raw\"}[1h]))/clamp_min(sum(increase(sccache_compilations_total{instance=~\".*\",resolution=\"raw\",result=\"performed\"}[1h])),1)",
        "legend": ""
      }
    ]
  },
  {
    "title": "Dist errors (1h)",
    "unit": "short",
    "queries": [
      {
        "expr": "sum(increase(sccache_dist_events_total{instance=~\".*\",resolution=\"raw\",event=\"error\"}[1h]))",
        "legend": ""
      }
    ]
  },
  {
    "title": "Request throughput",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(instance)(rate(sccache_requests_total{instance=~\".*\",resolution=\"raw\",result=\"compile\"}[5m]))",
        "legend": "{{instance}} compile/s"
      },
      {
        "expr": "sum by(instance)(rate(sccache_requests_total{instance=~\".*\",resolution=\"raw\",result=\"executed\"}[5m]))",
        "legend": "{{instance}} executed/s"
      }
    ]
  },
  {
    "title": "Cache requests",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(instance,result)(rate(sccache_cache_requests_total{instance=~\".*\",resolution=\"raw\"}[5m]))",
        "legend": "{{instance}} {{result}}"
      }
    ]
  },
  {
    "title": "Distributed compiles by worker",
    "unit": "ops",
    "queries": [
      {
        "expr": "((label_replace((sum by(server)(rate(sccache_dist_compiles_total{instance=~\".*\",resolution=\"raw\"}[5m]))), \"tailscale_ip\", \"$1\", \"server\", \"([^:]+):.*\")) * on(tailscale_ip) group_left(hostname) (max by(tailscale_ip,hostname) ({__name__=~\"tailscale_(peer|self)_info\",resolution=\"raw\",tailscale_ip!=\"\"}))) or (label_replace(((label_replace((sum by(server)(rate(sccache_dist_compiles_total{instance=~\".*\",resolution=\"raw\"}[5m]))), \"tailscale_ip\", \"$1\", \"server\", \"([^:]+):.*\")) unless on(tailscale_ip) (max by(tailscale_ip,hostname) ({__name__=~\"tailscale_(peer|self)_info\",resolution=\"raw\",tailscale_ip!=\"\"}))), \"hostname\", \"$1\", \"server\", \"(.*)\"))",
        "legend": "{{hostname}}"
      }
    ]
  },
  {
    "title": "Cache hit rate by language",
    "unit": "percent",
    "queries": [
      {
        "expr": "100*sum by(language)(rate(sccache_cache_requests_total{instance=~\".*\",resolution=\"raw\",result=\"hit\"}[5m]))/sum by(language)(rate(sccache_cache_requests_total{instance=~\".*\",resolution=\"raw\",result=~\"hit|miss\"}[5m]))",
        "legend": "{{language}}"
      }
    ]
  },
  {
    "title": "Non-cacheable reasons",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(reason)(rate(sccache_not_cached_total{instance=~\".*\",resolution=\"raw\"}[5m]))",
        "legend": "{{reason}}"
      },
      {
        "expr": "sum by(crate_type)(rate(sccache_not_cached_crate_types_total{instance=~\".*\",resolution=\"raw\"}[5m]))",
        "legend": "crate-type: {{crate_type}}"
      }
    ]
  },
  {
    "title": "Request disposition",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(instance,result)(rate(sccache_requests_total{instance=~\".*\",resolution=\"raw\",result=~\"executed|not_cacheable|unsupported_compiler|not_compile\"}[5m]))",
        "legend": "{{instance}} {{result}}"
      }
    ]
  },
  {
    "title": "Average compile time",
    "unit": "s",
    "queries": [
      {
        "expr": "sum by(instance)(rate(sccache_duration_seconds_total{instance=~\".*\",resolution=\"raw\",operation=\"compile\"}[5m]))/clamp_min(sum by(instance)(rate(sccache_compilations_total{instance=~\".*\",resolution=\"raw\",result=\"performed\"}[5m])),1e-9)",
        "legend": "{{instance}}"
      }
    ]
  },
  {
    "title": "Cache operation latency",
    "unit": "s",
    "queries": [
      {
        "expr": "sum by(instance)(rate(sccache_duration_seconds_total{instance=~\".*\",resolution=\"raw\",operation=\"cache_write\"}[5m]))/clamp_min(sum by(instance)(rate(sccache_cache_events_total{instance=~\".*\",resolution=\"raw\",event=\"write\"}[5m])),1e-9)",
        "legend": "{{instance}} write"
      },
      {
        "expr": "sum by(instance)(rate(sccache_duration_seconds_total{instance=~\".*\",resolution=\"raw\",operation=\"cache_read_hit\"}[5m]))/clamp_min(sum by(instance)(rate(sccache_cache_requests_total{instance=~\".*\",resolution=\"raw\",result=\"hit\"}[5m])),1e-9)",
        "legend": "{{instance}} read hit"
      }
    ]
  },
  {
    "title": "L0 cache latency",
    "unit": "s",
    "queries": [
      {
        "expr": "sum by(instance,name)(rate(sccache_cache_level_duration_seconds_total{instance=~\".*\",resolution=\"raw\",operation=\"write\"}[5m]))/clamp_min(sum by(instance,name)(rate(sccache_cache_level_operations_total{instance=~\".*\",resolution=\"raw\",operation=\"write\"}[5m])),1e-9)",
        "legend": "{{instance}} {{name}} write"
      },
      {
        "expr": "sum by(instance,name)(rate(sccache_cache_level_duration_seconds_total{instance=~\".*\",resolution=\"raw\",operation=\"hit\"}[5m]))/clamp_min(sum by(instance,name)(rate(sccache_cache_level_operations_total{instance=~\".*\",resolution=\"raw\",operation=\"hit\"}[5m])),1e-9)",
        "legend": "{{instance}} {{name}} hit"
      }
    ]
  },
  {
    "title": "Cache-level operations",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(instance,name,operation)(rate(sccache_cache_level_operations_total{instance=~\".*\",resolution=\"raw\"}[5m]))",
        "legend": "{{instance}} {{name}} {{operation}}"
      }
    ]
  },
  {
    "title": "Cache errors / unusual events",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(instance,event)(rate(sccache_cache_events_total{instance=~\".*\",resolution=\"raw\",event=~\"timeout|read_error|write_error|forced_recache|non_cacheable_compilation\"}[5m]))",
        "legend": "{{instance}} {{event}}"
      }
    ]
  },
  {
    "title": "Compile & distributed failures",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(instance)(rate(sccache_compilations_total{instance=~\".*\",resolution=\"raw\",result=\"failed\"}[5m]))",
        "legend": "{{instance}} compile failures/s"
      },
      {
        "expr": "sum by(instance)(rate(sccache_dist_events_total{instance=~\".*\",resolution=\"raw\",event=\"error\"}[5m]))",
        "legend": "{{instance}} dist errors/s"
      }
    ]
  },
  {
    "title": "Distributed compiles in selected range",
    "unit": "short",
    "queries": [
      {
        "expr": "((label_replace((sum by(server)(increase(sccache_dist_compiles_total{instance=~\".*\",resolution=\"raw\"}[1h]))), \"tailscale_ip\", \"$1\", \"server\", \"([^:]+):.*\")) * on(tailscale_ip) group_left(hostname) (max by(tailscale_ip,hostname) ({__name__=~\"tailscale_(peer|self)_info\",resolution=\"raw\",tailscale_ip!=\"\"}))) or (label_replace(((label_replace((sum by(server)(increase(sccache_dist_compiles_total{instance=~\".*\",resolution=\"raw\"}[1h]))), \"tailscale_ip\", \"$1\", \"server\", \"([^:]+):.*\")) unless on(tailscale_ip) (max by(tailscale_ip,hostname) ({__name__=~\"tailscale_(peer|self)_info\",resolution=\"raw\",tailscale_ip!=\"\"}))), \"hostname\", \"$1\", \"server\", \"(.*)\"))",
        "legend": "{{hostname}}"
      }
    ]
  },
  {
    "title": "Certifex scheduler ingress",
    "unit": "reqps",
    "queries": [
      {
        "expr": "sum by(status_class)(rate(certifex_proxy_requests_total{host=\"sccache.onhir.eu\",resolution=\"raw\"}[5m]))",
        "legend": "{{status_class}}"
      }
    ]
  },
  {
    "title": "Certifex backend failures",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum(rate(certifex_backend_failures_total{host=\"sccache.onhir.eu\",resolution=\"raw\"}[5m]))",
        "legend": "backend failures/s"
      }
    ]
  },
  {
    "title": "Metrics freshness",
    "unit": "s",
    "queries": [
      {
        "expr": "time()-metrics_push_last_success_unixtime{instance=~\".*\",resolution=\"raw\"}",
        "legend": "{{instance}}"
      }
    ]
  },
  {
    "title": "Preprocessor cache mode",
    "unit": "bool",
    "queries": [
      {
        "expr": "max(sccache_preprocessor_cache_mode{instance=~\".*\",resolution=\"raw\"})",
        "legend": ""
      }
    ]
  },
  {
    "title": "Cache levels",
    "unit": "short",
    "queries": [
      {
        "expr": "max(sccache_cache_levels{instance=~\".*\",resolution=\"raw\"})",
        "legend": ""
      }
    ]
  },
  {
    "title": "Basedirs",
    "unit": "short",
    "queries": [
      {
        "expr": "max(sccache_basedirs{instance=~\".*\",resolution=\"raw\"})",
        "legend": ""
      }
    ]
  },
  {
    "title": "Versions",
    "unit": "",
    "queries": [
      {
        "expr": "sccache_info{instance=~\".*\",resolution=\"raw\"}",
        "legend": "{{instance}} {{version}}"
      }
    ]
  },
  {
    "title": "Linux worker CPU busy",
    "unit": "percent",
    "queries": [
      {
        "expr": "100*sum by(instance)(rate(cpu_seconds_total{instance=~\".+\",resolution=\"raw\",cpu=\"total\",mode!~\"idle|iowait\"}[5m]))/clamp_min(sum by(instance)(rate(cpu_seconds_total{instance=~\".+\",resolution=\"raw\",cpu=\"total\"}[5m])),1e-9)",
        "legend": "{{instance}}"
      }
    ]
  },
  {
    "title": "Linux worker memory used",
    "unit": "percent",
    "queries": [
      {
        "expr": "100*(1-meminfo{instance=~\".+\",resolution=\"raw\",field=\"mem_available\"}/ignoring(field) meminfo{instance=~\".+\",resolution=\"raw\",field=\"mem_total\"})",
        "legend": "{{instance}}"
      }
    ]
  },
  {
    "title": "Linux worker load",
    "unit": "short",
    "queries": [
      {
        "expr": "load_average{instance=~\".+\",resolution=\"raw\",interval=\"1\"}",
        "legend": "{{instance}}"
      }
    ]
  },
  {
    "title": "Compiler/language cache hit rate",
    "unit": "percent",
    "queries": [
      {
        "expr": "100*sum by(compiler_language)(rate(sccache_cache_requests_advanced_total{instance=~\".*\",resolution=\"raw\",result=\"hit\"}[5m]))/sum by(compiler_language)(rate(sccache_cache_requests_advanced_total{instance=~\".*\",resolution=\"raw\",result=~\"hit|miss\"}[5m]))",
        "legend": "{{compiler_language}}"
      }
    ]
  },
  {
    "title": "Compiler/language cache requests",
    "unit": "ops",
    "queries": [
      {
        "expr": "sum by(compiler_language,result)(rate(sccache_cache_requests_advanced_total{instance=~\".*\",resolution=\"raw\"}[5m]))",
        "legend": "{{compiler_language}} {{result}}"
      }
    ]
  }
]
